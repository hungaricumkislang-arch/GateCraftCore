      else if(t==5){double ma=v[1]/100d,price=ma<1?v[0]/(1-ma):0;r="Net target = "+gcEF(price,2)+"\nProfit = "+gcEF(price-v[0],2);f="Price = cost / (1 − margin)";if(v[1]>=100)w=gcW("INVALID");gcEngPut(mm,"cost",price);gcEngPut(mm,"profit",price-v[0]);gcEngPut(mm,"marginPct",v[1]);}
      else if(t==6){double B=v[0]/1000d,H=v[1]/1000d,W=v[2]*GC_ENG_G,Mg=W*B/2,vert=v[3]>0?W/v[3]:0,couple=v[4]>0?Mg/(v[4]/1000d):0,wind=gcWindOrProfile(v[5]),q=gcWind(wind),A=B*H,F=q*v[6]*v[7]*A,Mh=F*B/2,Mb=F*H/2,allow=v[8]*1000,util=allow>0?Math.max(Mg,Mb)/allow*100:0;r="W = "+gcEF(W,1)+" N\nMg = "+gcEF(Mg,1)+" Nm\nR_hinge = "+gcEF(couple,1)+" N\nF_wind = "+gcEF(F,1)+" N\nM_base = "+gcEF(Mb,1)+" Nm\nutil = "+gcEF(util,1)+" %";f="Mg=m·g·B/2; R=Mg/hinge spacing; Fw=q·Cd·solidity·A";if(wind<=0)w=gcW("NO_WIND");if(allow>0&&util>100)w+=(w.length()>0?"\n":"")+gcW("LIMIT");gcEngPut(mm,"massKg",v[2]);gcEngPut(mm,"forceN",Math.max(couple,F));gcEngPut(mm,"momentNm",Math.max(Mg,Mb));gcEngPut(mm,"areaM2",A);}
      else if(t==7){double th=Math.atan(v[4]/100d),W=v[0]*GC_ENG_G,roll=W*v[3],sl=W*Math.sin(th),wind=gcWindOrProfile(v[7]),q=gcWind(wind),A=v[1]/1000d*v[2]/1000d,fw=q*v[8]*A*Math.max(0,Math.min(1,v[9])),steady=roll+sl+fw,req=steady*v[5],pow=v[11]>0?req*v[10]/v[11]:0,roller=v[6]>0?W/v[6]:0;r="F_roll = "+gcEF(roll,1)+" N\nF_slope = "+gcEF(sl,1)+" N\nF_wind = "+gcEF(fw,1)+" N\nF_start = "+gcEF(req,1)+" N\nP ≈ "+gcEF(pow,1)+" W\nR/roller = "+gcEF(roller,1)+" N";f="Fstart=(m·g·μ + slope + wind)·factor; P=F·speed/η";if(v[11]<=0)w=gcW("INVALID");gcEngPut(mm,"massKg",v[0]);gcEngPut(mm,"forceN",req);gcEngPut(mm,"powerW",pow);gcEngPut(mm,"areaM2",A);}
      else if(t==8){double W=v[2]*GC_ENG_G,d=v[3]/1000d,cg=v[4]/1000d,rear=d>0?-(W*cg/d):0,front=W-rear,ratio=v[0]>0?(v[1]-v[0])/v[0]:0,M=W*cg,wind=gcWindOrProfile(v[6]),q=gcWind(wind),A=v[1]/1000d*v[5]/1000d,F=q*v[7]*v[8]*A,Mw=F*(v[5]/1000d)/2;r="R_front = "+gcEF(front,1)+" N\nR_rear = "+gcEF(rear,1)+" N\n|R_rear| = "+gcEF(Math.abs(rear),1)+" N\nM_g = "+gcEF(M,1)+" Nm\nCounterweight ratio = "+gcEF(ratio*100,1)+" %\nF_wind = "+gcEF(F,1)+" N\nM_wind = "+gcEF(Mw,1)+" Nm";f="Rrear=−W·cg/d; Rfront=W−Rrear; ratio=(Ltotal−opening)/opening";if(d<=0)w=gcW("INVALID");gcEngPut(mm,"massKg",v[2]);gcEngPut(mm,"forceN",Math.max(front,Math.abs(rear)));gcEngPut(mm,"momentNm",Math.max(Math.abs(M),Mw));gcEngPut(mm,"areaM2",A);}
      else if(t==9){boolean sliding=v[0]<1.5;double wind=gcWindOrProfile(v[6]),q=gcWind(wind),A=v[2]/1000d*v[3]/1000d,Fw=q*v[7]*v[8]*A,W=v[1]*GC_ENG_G,req=0,T=0;if(sliding){double th=Math.atan(v[5]/100d);req=(W*v[4]+W*Math.sin(th)+Fw)*v[10];}else{T=Fw*(v[2]/1000d)/2;req=v[9]>0?(T/(v[9]/1000d))*v[10]:0;}double pow=v[12]>0?req*v[11]/v[12]:0,duty=v[13]*v[14]/3600d*100;r="A = "+gcEF(A,2)+" m²\nF_wind = "+gcEF(Fw,1)+" N\nT = "+gcEF(T,1)+" Nm\nF_start = "+gcEF(req,1)+" N\nP ≈ "+gcEF(pow,1)+" W\nDuty = "+gcEF(duty,1)+" %";f=sliding?"Fstart=(rolling+slope+wind)·factor":"Factuator=(Fwind·B/2)/lever·factor";if(duty>80)w=gcW("LIMIT");gcEngPut(mm,"massKg",v[1]);gcEngPut(mm,"forceN",req);gcEngPut(mm,"momentNm",T);gcEngPut(mm,"powerW",pow);gcEngPut(mm,"areaM2",A);}
      else if(t==10){double wind=gcWindOrProfile(v[3]),sigma=v[7]>0?v[7]:gcCProf("GC_ENG_SIGMA",0),q=gcWind(wind),A=v[0]*v[1],F=q*v[4]*v[5]*A,M=F*v[0]/2,total=q*v[4]*v[5]*v[0]*v[2],allow=v[6]*1000,util=allow>0?M/allow*100:0,Wreq=sigma>0?M*1000/sigma:0,smax=(allow>0&&q*v[4]*v[5]*v[0]*v[0]>0)?2*allow/(q*v[4]*v[5]*v[0]*v[0]):0;r="A/post = "+gcEF(A,3)+" m²\nF/post = "+gcEF(F,1)+" N\nM/post = "+gcEF(M/1000,3)+" kNm\nF_total = "+gcEF(total,1)+" N\nutil = "+gcEF(util,1)+" %\nWreq = "+gcEF(Wreq,0)+" mm³\ns_max = "+gcEF(smax,3)+" m";f="F=q·Cd·solidity·h·s; M=F·h/2; Wreq=M_Nmm/σ";if(wind<=0)w=gcW("NO_WIND");if(allow>0&&util>100)w+=(w.length()>0?"\n":"")+gcW("LIMIT");gcEngPut(mm,"forceN",F);gcEngPut(mm,"momentNm",M);gcEngPut(mm,"areaM2",A);gcEngPut(mm,"lengthM",v[1]);}
      else if(t==11){double vol=v[0]*v[1]*v[2]*v[3],order=vol*(1+v[4]/100d),form=2*(v[0]+v[1])*v[2]*v[3]+(v[7]>0.5?v[0]*v[1]*v[3]:0),rebar=vol*v[5],trips=v[6]>0?Math.ceil(order/v[6]):0;r="V_net = "+gcEF(vol,4)+" m³\nV_order = "+gcEF(order,4)+" m³\nForm = "+gcEF(form,3)+" m²\nRebar ≈ "+gcEF(rebar,1)+" kg\nTruck = "+gcEF(trips,0)+" db";f="V=L·W·D·count; Vorder=V·(1+reserve); form=2·(L+W)·D·count";gcEngPut(mm,"volumeM3",order);gcEngPut(mm,"areaM2",form);gcEngPut(mm,"massKg",rebar);gcEngPut(mm,"count",trips);}
      else if(t==12){if(v[0]<=0||v[1]<=0||v[2]<=0||v[3]<=0)throw new Exception("input");double courses=Math.ceil(v[1]*1000/v[3]),per=Math.ceil(v[0]*1000/v[2]),base=courses*per,res=Math.ceil(base*Math.max(0,v[4])/100),total=base+res,special=(Math.max(0,v[5])+Math.max(0,v[6]))*courses,vert=v[7]>0?Math.ceil(v[0]*1000/v[7])+1:0,vlen=vert*v[1],hlen=Math.max(0,v[8])*courses*v[0],pbars=Math.max(0,v[9])*Math.max(0,v[10]),fill=base*Math.max(0,v[11])/1000;r="Courses = "+gcEF(courses,0)+"\nBlocks/course = "+gcEF(per,0)+"\nBuilt = "+gcEF(base,0)+" db\nReserve = "+gcEF(res,0)+" db\nOrder = "+gcEF(total,0)+" db\nCorner/end positions = "+gcEF(special,0)+"\nVertical bars = "+gcEF(vert,0)+" db / "+gcEF(vlen,2)+" m\nHorizontal bars = "+gcEF(hlen,2)+" m\nPillar bars = "+gcEF(pbars,0)+" db\nFill = "+gcEF(fill,3)+" m³";f="courses=ceil(H/blockH); built=courses·ceil(L/blockL); reserve=ceil(built·%); fill=built·L/block";gcEngPut(mm,"count",total);gcEngPut(mm,"lengthM",vlen+hlen);gcEngPut(mm,"volumeM3",fill);}
      else if(t==13){double excav=v[0]*v[1]/100,subComp=v[0]*v[2]/100,subOrder=subComp*v[4],subTon=subOrder*v[3],bedVol=v[0]*v[5]/100,bedTon=bedVol*v[6],pavers=v[0]*(1+v[7]/100),geo=v[0]*(1+v[8]/100),sand=v[0]*v[9];r="Excav = "+gcEF(excav,3)+" m³\nSubbase compact = "+gcEF(subComp,3)+" m³\nSubbase order = "+gcEF(subOrder,3)+" m³ / "+gcEF(subTon,2)+" t\nBedding = "+gcEF(bedVol,3)+" m³ / "+gcEF(bedTon,2)+" t\nPavers = "+gcEF(pavers,2)+" m²\nGeotextile = "+gcEF(geo,2)+" m²\nJoint sand = "+gcEF(sand,1)+" kg\nEdge = "+gcEF(v[10],2)+" m";f="volume=area·depth; order=compact volume·loose factor; pavers=area·(1+reserve)";if(v[2]+v[5]>v[1])w=gcW("LIMIT");gcEngPut(mm,"areaM2",pavers);gcEngPut(mm,"volumeM3",excav);gcEngPut(mm,"massKg",(subTon+bedTon)*1000);gcEngPut(mm,"lengthM",v[10]);}
      else if(t==14){double M=0,mx=0,my=0,mz=0,c=0;for(int j=0;j<3;j++){double mass=v[j*4];if(mass>0){M+=mass;mx+=mass*v[j*4+1];my+=mass*v[j*4+2];mz+=mass*v[j*4+3];c++;}}double x=M>0?mx/M:0,y=M>0?my/M:0,z=M>0?mz/M:0;r="m_total = "+gcEF(M,3)+" kg\nXcg = "+gcEF(x,1)+" mm\nYcg = "+gcEF(y,1)+" mm\nZcg = "+gcEF(z,1)+" mm\nitems = "+gcEF(c,0);f="Xcg=Σ(m·x)/Σm; Ycg=Σ(m·y)/Σm; Zcg=Σ(m·z)/Σm";if(M<=0)w=gcW("INVALID");gcEngPut(mm,"massKg",M);gcEngPut(mm,"count",c);}
      else if(t==15){if(v[0]<=0||v[1]<=0)throw new Exception("input");double b=Math.max(0,Math.min(100,v[4])),A=v[0]/1000*v[1]/1000,mass=A*Math.max(0,v[2])+Math.max(0,v[3]),W=mass*GC_ENG_G,unbal=W*(1-b/100),fr=W*Math.max(0,v[5]),lift=Math.max(0,unbal)+fr,balanceF=W*b/100,T=balanceF*Math.max(0,v[6])/1000,tilt=W*(v[1]/1000)/2*(1-b/100);boolean head=v[8]<=0||v[7]>=v[8],side=v[10]<=0||v[9]>=v[10];r="A = "+gcEF(A,2)+" m²\nm = "+gcEF(mass,1)+" kg\nF_unbalanced = "+gcEF(unbal,1)+" N\nF_move ≈ "+gcEF(lift,1)+" N\nF_balance = "+gcEF(balanceF,1)+" N\nT_drum ≈ "+gcEF(T,1)+" Nm\nM_tilt ≈ "+gcEF(tilt,1)+" Nm\nHead = "+(head?"OK":"CHECK")+"\nSide = "+(side?"OK":"CHECK");f="m=A·kg/m²+hardware; Fmove=W·(1−balance)+W·friction; T=Fbalance·r";if(!head||!side)w=gcW("LIMIT");gcEngPut(mm,"massKg",mass);gcEngPut(mm,"forceN",lift);gcEngPut(mm,"momentNm",Math.max(T,tilt));gcEngPut(mm,"areaM2",A);}
      else if(t==16){if(v[0]<=0||v[1]<=0||v[2]<0||v[3]<0||v[4]<0||v[3]+v[4]<=0)throw new Exception("input");double sides=Math.max(1,Math.round(v[5]==0?1:v[5])),spans=Math.max(1,Math.ceil(v[0]/v[1])),posts=spans+1,spacing=v[0]/spans,clear=Math.max(0,spacing-v[2]),need=Math.max(0,Math.ceil((clear-v[4])/(v[3]+v[4]))),gap=(clear-need*v[3])/(need+1),bals=need*spans*sides,hand=v[0]/1000*sides;r="spans = "+gcEF(spans,0)+"\nposts/side = "+gcEF(posts,0)+"\npost spacing = "+gcEF(spacing,1)+" mm\nbalusters/span = "+gcEF(need,0)+"\nclear gap = "+gcEF(gap,1)+" mm\nbalusters total = "+gcEF(bals,0)+"\nhandrail = "+gcEF(hand,3)+" m";f="spans=ceil(L/max spacing); gap=(clear−n·balusterW)/(n+1)";if(gap>v[4]+0.001)w=gcW("LIMIT");gcEngPut(mm,"count",bals);gcEngPut(mm,"lengthM",hand);}
