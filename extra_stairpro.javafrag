  // ------------------------------------------------------------------
  // GateCraft StairPro helpers (v2.8)
  // Pure stair geometry/material calculations kept out of Blockly/YAIL.
  // ------------------------------------------------------------------

  private double spD(Object v, double fallback) { return SafeNumber(v, fallback); }
  private int spI(Object v, int fallback) { double d=SafeNumber(v,fallback); return (int)Math.round(d); }
  private double spRound(double v, int n) { double p=Math.pow(10.0,n); return Math.round(v*p)/p; }
  private String spNorm(String s) { return s==null?"":s.trim().toUpperCase(java.util.Locale.US); }
  private double spListD(YailList l,int oneBased,double fallback){ if(l==null||oneBased<1||oneBased>l.size())return fallback; return SafeNumber(l.getObject(oneBased-1),fallback); }
  private boolean spListB(YailList l,int oneBased,boolean fallback){ if(l==null||oneBased<1||oneBased>l.size())return fallback; Object o=l.getObject(oneBased-1); if(o instanceof Boolean)return ((Boolean)o).booleanValue(); String s=String.valueOf(o); return "true".equalsIgnoreCase(s)||"1".equals(s); }

  @SimpleFunction(description="Returns the stable StairPro geometry mode code for a localized spinner index.")
  public String StairGeometryMode(double selectionIndex){int i=(int)Math.round(selectionIndex);return i==2?"TARGET_RISER":i==3?"TARGET_GOING":i==4?"MAX_RUN":"COUNT";}

  @SimpleFunction(description="StairPro shared geometry core. Returns [valid,error,rise,width,riserCount,treadCount,riserHeight,going,run,slope,angle,comfort,minHeadroom,comfortStatus,steps].")
  public YailList StairGeometry(double totalRiseMm,double stairWidthMm,String inputMode,double riserCountInput,double targetRiserMm,double targetGoingMm,double maxRunMm,boolean separateTopTread,boolean checkHeadroom,double floorOpeningStartMm,double ceilingHeightMm,double comfortMinMm,double comfortMaxMm){
    String mode=spNorm(inputMode); int count=(int)Math.round(riserCountInput); double going=targetGoingMm;
    if(totalRiseMm<=0)return list(false,"GEO_NO_RISE",totalRiseMm,stairWidthMm,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList());
    if(stairWidthMm<=0)return list(false,"GEO_NO_WIDTH",totalRiseMm,stairWidthMm,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList());
    if("TARGET_RISER".equals(mode)){ if(targetRiserMm<=0)return list(false,"GEO_INVALID_TARGET_RISER",totalRiseMm,stairWidthMm,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList()); count=Math.max(2,(int)Math.round(totalRiseMm/targetRiserMm)); }
    if(count<2)return list(false,"GEO_INVALID_COUNT",totalRiseMm,stairWidthMm,(double)count,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList());
    int treads=separateTopTread?count:count-1; if(treads<1)treads=1;
    if("MAX_RUN".equals(mode)){ if(maxRunMm<=0)return list(false,"GEO_INVALID_MAX_RUN",totalRiseMm,stairWidthMm,(double)count,(double)treads,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList()); going=maxRunMm/treads; }
    else if("TARGET_GOING".equals(mode)){ going=targetGoingMm; }
    else if(going<=0 && maxRunMm>0){ going=maxRunMm/treads; }
    if(going<=0)return list(false,"GEO_INVALID_GOING",totalRiseMm,stairWidthMm,(double)count,(double)treads,0.0d,going,0.0d,0.0d,0.0d,0.0d,-1.0d,"INVALID",YailList.makeEmptyList());
    double riser=totalRiseMm/count, run=treads*going, slope=Math.sqrt(totalRiseMm*totalRiseMm+run*run), angle=Math.toDegrees(Math.atan2(totalRiseMm,run)), comfort=2*riser+going;
    java.util.ArrayList<Object> steps=new java.util.ArrayList<Object>(); double minHead=Double.POSITIVE_INFINITY;
    for(int i=1;i<=count;i++){ double x=Math.min(i,treads)*going; double z=i*riser; if(checkHeadroom && ceilingHeightMm>0 && floorOpeningStartMm>0 && x<floorOpeningStartMm) minHead=Math.min(minHead,ceilingHeightMm-z); steps.add(YailList.makeList(new Object[]{(double)i,spRound(x,1),spRound(z,1)})); }
    double minHeadOut=(minHead==Double.POSITIVE_INFINITY)?-1.0d:minHead;
    String comfortStatus="UNKNOWN"; if(comfortMinMm>0&&comfortMaxMm>0)comfortStatus=(comfort>=comfortMinMm&&comfort<=comfortMaxMm)?"PASS_PRELIMINARY":(comfort<comfortMinMm?"LOW":"HIGH");
    return list(true,"",spRound(totalRiseMm,1),spRound(stairWidthMm,1),(double)count,(double)treads,spRound(riser,2),spRound(going,2),spRound(run,1),spRound(slope,1),spRound(angle,2),spRound(comfort,1),spRound(minHeadOut,1),comfortStatus,YailList.makeList(steps));
  }

  @SimpleFunction(description="StairPro quick designer. Returns top five candidate records [count,treads,riser,going,run,slope,angle,comfort,score,status].")
  public YailList StairQuickDesign(double totalRiseMm,double maxRunMm,double stairWidthMm,String priority,double comfortMinMm,double comfortMaxMm,double minRiserMm,double maxRiserMm,double minGoingMm,double maxGoingMm,double maxAngleDeg){
    java.util.ArrayList<YailList> out=new java.util.ArrayList<YailList>(); if(totalRiseMm<=0||maxRunMm<=0||stairWidthMm<=0)return YailList.makeEmptyList();
    double loR=minRiserMm>0?minRiserMm:140, hiR=maxRiserMm>0?maxRiserMm:220; int minC=Math.max(2,(int)Math.floor(totalRiseMm/hiR)-2), maxC=Math.max(minC,(int)Math.ceil(totalRiseMm/loR)+2); String pri=spNorm(priority);
    for(int c=minC;c<=maxC;c++){ int t=Math.max(1,c-1); double r=totalRiseMm/c,g=maxRunMm/t,run=g*t,s=Math.sqrt(totalRiseMm*totalRiseMm+run*run),a=Math.toDegrees(Math.atan2(totalRiseMm,run)),comfort=2*r+g; if(g<=0)continue; boolean prof=(r>=loR&&r<=hiR&&(minGoingMm<=0||g>=minGoingMm)&&(maxGoingMm<=0||g<=maxGoingMm)&&(maxAngleDeg<=0||a<=maxAngleDeg)); double score=prof?50:0; if(comfortMinMm>0&&comfortMaxMm>0){double mid=(comfortMinMm+comfortMaxMm)/2.0,half=Math.max(1,(comfortMaxMm-comfortMinMm)/2.0); score+=Math.max(0,20-20*Math.abs(comfort-mid)/(half*2));} if(pri.contains("COMFORT"))score+=Math.max(0,20-Math.abs(a-32)); else if(pri.contains("SPACE"))score+=20*Math.max(0,1-run/maxRunMm); else if(pri.contains("LOW_RISER"))score+=Math.max(0,20-(r-loR)/4); else if(pri.contains("LARGE_GOING"))score+=Math.min(20,g/20); else score+=10; score+=Math.max(0,10-10*run/maxRunMm); String st=prof?"PASS_PRELIMINARY":(a>40?"STEEP":"CHECK_PROFILE"); out.add(list((double)c,(double)t,spRound(r,1),spRound(g,1),spRound(run,1),spRound(s,1),spRound(a,1),spRound(comfort,1),spRound(score,1),st)); }
    java.util.Collections.sort(out,new java.util.Comparator<YailList>(){public int compare(YailList a,YailList b){return Double.compare(spListD(b,9,0),spListD(a,9,0));}}); java.util.ArrayList<Object> top=new java.util.ArrayList<Object>(); for(int i=0;i<out.size()&&i<5;i++)top.add(out.get(i)); return YailList.makeList(top);
  }

  @SimpleFunction(description="StairPro L/U/two-flight landing geometry. Returns [valid,error,type,f1Risers,f2Risers,f1Treads,f2Treads,riserHeight,f1Run,f2Run,f1Slope,f2Slope,landingLength,width,totalPath].")
  public YailList StairLanding(YailList geometry,String type,String distribution,double flight1Input,double flight2Input,double landingLengthMm,double widthMm){
    if(!spListB(geometry,1,false))return list(false,"LANDING_GEOMETRY_INVALID",type,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,landingLengthMm,widthMm,0.0d); int total=spI(geometry.getObject(4),0); double riser=spListD(geometry,7,0),going=spListD(geometry,8,0); int f1,f2; String d=spNorm(distribution); if("MANUAL".equals(d)){f1=(int)Math.round(flight1Input);f2=(int)Math.round(flight2Input);if(f1+f2!=total||f1<1||f2<1)return list(false,"LANDING_DISTRIBUTION_INVALID",type,(double)f1,(double)f2,0.0d,0.0d,riser,0.0d,0.0d,0.0d,0.0d,landingLengthMm,widthMm,0.0d);}else{f1=total/2;f2=total-f1;if("EQUAL".equals(d)&&total%2==0){f1=total/2;f2=total/2;}}
    int t1=Math.max(1,f1-1),t2=Math.max(1,f2-1); double r1=t1*going,r2=t2*going,s1=Math.sqrt(Math.pow(f1*riser,2)+r1*r1),s2=Math.sqrt(Math.pow(f2*riser,2)+r2*r2); return list(true,"",type,(double)f1,(double)f2,(double)t1,(double)t2,spRound(riser,2),spRound(r1,1),spRound(r2,1),spRound(s1,1),spRound(s2,1),spRound(landingLengthMm,1),spRound(widthMm,1),spRound(s1+s2,1));
  }

  @SimpleFunction(description="StairPro steel quantity estimate. Geometry/landing feed a single shared path. Returns [valid,pathMm,stringerPurchaseM,supportCount,supportTotalM,treadAreaM2,weightKg,weldM,cost,cutList,status].")
  public YailList StairSteel(YailList geometry,YailList landing,boolean useLanding,double stringerCount,double stringerKgM,double stringerPriceM,double supportsPerStep,double supportKgM,double supportPriceM,double treadOverhangMm,double treadPriceM2,double treadKgM2,double reservePercent,double wastePercent,boolean weldEstimate,double weldPerStepMm){
    if(!spListB(geometry,1,false))return list(false,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,YailList.makeEmptyList(),"GEOMETRY_REQUIRED"); double path=spListD(geometry,10,0); if(useLanding&&spListB(landing,1,false))path=spListD(landing,15,path); int t=spI(geometry.getObject(5),0); double width=spListD(geometry,4,0),going=spListD(geometry,8,0), sc=Math.max(1,stringerCount), stringerM=path/1000.0*sc, stringerPurchase=stringerM*(1+reservePercent/100.0), supportCount=Math.max(0,t*Math.max(0,supportsPerStep)), supportM=supportCount*width/1000.0, treadDepth=going+treadOverhangMm, area=width/1000.0*treadDepth/1000.0*t, purchaseArea=area*(1+wastePercent/100.0); double weight=stringerM*Math.max(0,stringerKgM)+supportM*Math.max(0,supportKgM)+area*Math.max(0,treadKgM2), weld=weldEstimate?t*weldPerStepMm/1000.0:0, cost=stringerPurchase*Math.max(0,stringerPriceM)+supportM*Math.max(0,supportPriceM)+purchaseArea*Math.max(0,treadPriceM2); java.util.ArrayList<Object> cut=new java.util.ArrayList<Object>(); cut.add(list("STRINGER",(double)Math.round(sc),spRound(path,1))); if(supportCount>0)cut.add(list("STEP_SUPPORT",spRound(supportCount,0),spRound(width,1))); return list(true,spRound(path,1),spRound(stringerPurchase,3),spRound(supportCount,0),spRound(supportM,3),spRound(purchaseArea,3),spRound(weight,2),spRound(weld,2),spRound(cost,2),YailList.makeList(cut),(stringerKgM>0&&supportKgM>0)?"ESTIMATE":"PARTIAL_WEIGHT");
  }

  @SimpleFunction(description="StairPro concrete geometry estimate. Returns [valid,slab,wedge,landing,total,withWaste,formwork,status].")
  public YailList StairConcrete(YailList geometry,YailList landing,boolean useLanding,double widthMm,double slabThicknessMm,double landingLengthMm,double landingThicknessMm,double wastePercent){
    if(!spListB(geometry,1,false)||widthMm<=0||slabThicknessMm<=0)return list(false,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,"GEOMETRY_REQUIRED"); double slope=spListD(geometry,10,0)/1000.0,w=widthMm/1000.0,th=slabThicknessMm/1000.0,r=spListD(geometry,7,0)/1000.0,g=spListD(geometry,8,0)/1000.0; int t=spI(geometry.getObject(5),0),risers=spI(geometry.getObject(4),0); double slab=slope*w*th,wedge=0.5*r*g*w*t,land=useLanding?landingLengthMm/1000.0*w*landingThicknessMm/1000.0:0,total=slab+wedge+land,ww=total*(1+wastePercent/100.0),form=slope*w+2*slope*th+risers*r*w+(useLanding?landingLengthMm/1000.0*w:0); return list(true,spRound(slab,4),spRound(wedge,4),spRound(land,4),spRound(total,4),spRound(ww,4),spRound(form,3),"GEOMETRIC_ESTIMATE");
  }

  @SimpleFunction(description="StairPro railing estimate. Returns [valid,slopeRailM,totalHandrailM,postCount,spacingMm,balusterCount,profileLengthM,cost,cutList,status].")
  public YailList StairRailing(YailList geometry,YailList landing,boolean useLanding,String side,double heightMm,double maxPostSpacingMm,double postProfileWidthMm,double postPriceM,double handrailPriceM,double bottomExtensionMm,double topExtensionMm,boolean balusterEnabled,double balusterWidthMm,double maxBalusterGapMm,double balusterPriceM,double landingRailLengthMm){
    if(!spListB(geometry,1,false)||maxPostSpacingMm<=0)return list(false,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,0.0d,YailList.makeEmptyList(),"GEOMETRY_REQUIRED"); int sides="BOTH".equals(spNorm(side))?2:1; double path=spListD(geometry,10,0); if(useLanding&&spListB(landing,1,false))path=spListD(landing,15,path); double section=path+Math.max(0,landingRailLengthMm), singleHandrail=section+bottomExtensionMm+topExtensionMm, totalHand=singleHandrail/1000.0*sides, slopeRail=path/1000.0*sides; int spans=Math.max(1,(int)Math.ceil(section/maxPostSpacingMm)), posts=(spans+1)*sides; double spacing=section/spans; int bals=0; if(balusterEnabled){double avail=Math.max(0,spacing-postProfileWidthMm), pitch=Math.max(1,maxBalusterGapMm+balusterWidthMm); bals=Math.max(0,(int)Math.ceil(avail/pitch)-1)*spans*sides;} double postM=posts*heightMm/1000.0, balM=bals*heightMm/1000.0, profileM=postM+totalHand+balM, cost=postM*Math.max(0,postPriceM)+totalHand*Math.max(0,handrailPriceM)+balM*Math.max(0,balusterPriceM); java.util.ArrayList<Object> cut=new java.util.ArrayList<Object>();cut.add(list("POST",(double)posts,spRound(heightMm,1)));cut.add(list("HANDRAIL",(double)sides,spRound(singleHandrail,1)));if(bals>0)cut.add(list("BALUSTER",(double)bals,spRound(heightMm,1))); return list(true,spRound(slopeRail,3),spRound(totalHand,3),(double)posts,spRound(spacing,1),(double)bals,spRound(profileM,3),spRound(cost,2),YailList.makeList(cut),"ESTIMATE");
  }

  @SimpleFunction(description="StairPro cost calculation. Returns [materials,labor,direct,profit,net,tax,gross].")
  public YailList StairCost(double materialCost,double laborHours,double hourlyRate,double travel,double other,double profitPercent,double taxPercent){ double labor=Math.max(0,laborHours)*Math.max(0,hourlyRate),direct=Math.max(0,materialCost)+labor+Math.max(0,travel)+Math.max(0,other),profit=direct*Math.max(0,profitPercent)/100.0,net=direct+profit,tax=net*Math.max(0,taxPercent)/100.0,gross=net+tax;return list(spRound(materialCost,2),spRound(labor,2),spRound(direct,2),spRound(profit,2),spRound(net,2),spRound(tax,2),spRound(gross,2)); }

  @SimpleFunction(description="StairPro preliminary profile check. Empty/zero limits are ignored. Returns [status,issueCodes].")
  public YailList StairProfileCheck(YailList geometry,YailList landing,YailList railing,double minRiser,double maxRiser,double minGoing,double maxGoing,double minWidth,double maxAngle,double minHeadroom,double minLanding,double minRailingHeight,double maxBalusterGap){ java.util.ArrayList<Object> issues=new java.util.ArrayList<Object>(); if(!spListB(geometry,1,false)){issues.add("GEO_INVALID");return list("UNKNOWN",YailList.makeList(issues));} double r=spListD(geometry,7,0),g=spListD(geometry,8,0),w=spListD(geometry,4,0),a=spListD(geometry,11,0),h=spListD(geometry,13,-1); if(minRiser>0&&r<minRiser)issues.add("GEO_RISER_LOW");if(maxRiser>0&&r>maxRiser)issues.add("GEO_RISER_HIGH");if(minGoing>0&&g<minGoing)issues.add("GEO_GOING_LOW");if(maxGoing>0&&g>maxGoing)issues.add("GEO_GOING_HIGH");if(minWidth>0&&w<minWidth)issues.add("GEO_WIDTH_LOW");if(maxAngle>0&&a>maxAngle)issues.add("GEO_ANGLE_HIGH");if(minHeadroom>0&&h>=0&&h<minHeadroom)issues.add("GEO_HEADROOM_LOW");if(minLanding>0&&spListB(landing,1,false)&&spListD(landing,13,0)<minLanding)issues.add("LANDING_TOO_SHORT"); String status=issues.isEmpty()?"PASS_PRELIMINARY":"FAIL_PRELIMINARY"; return list(status,YailList.makeList(issues)); }

  @SimpleFunction(description="StairPro display formatter for geometry step coordinate records.")
  public YailList StairStepDisplay(YailList steps,String unit){ java.util.ArrayList<Object> out=new java.util.ArrayList<Object>(); if(steps!=null)for(int i=0;i<steps.size();i++){java.util.ArrayList<Object>a=mdList(steps.getObject(i)); if(a.size()>=3)out.add(String.valueOf(spI(a.get(0),i+1))+". | X: "+spRound(spD(a.get(1),0),1)+" mm | Z: "+spRound(spD(a.get(2),0),1)+" mm");}return YailList.makeList(out); }

  @SimpleFunction(description="StairPro display formatter for cut-list records [code,qty,lengthMm].")
  public YailList StairCutDisplay(YailList cuts){java.util.ArrayList<Object>out=new java.util.ArrayList<Object>();if(cuts!=null)for(int i=0;i<cuts.size();i++){java.util.ArrayList<Object>a=mdList(cuts.getObject(i));if(a.size()>=3)out.add(mdString(a.get(0))+" | "+spRound(spD(a.get(1),0),0)+" db | "+spRound(spD(a.get(2),0),1)+" mm");}return YailList.makeList(out);}
