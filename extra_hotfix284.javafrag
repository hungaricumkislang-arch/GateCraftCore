  // ------------------------------------------------------------------
  // GateCraft build284 targeted compatibility-safe UI helpers.
  // Private helpers only: no editor-visible component API changes.
  // ------------------------------------------------------------------
  private String gc284ClearText(String code, int lang) {
    int l = lang < 1 || lang > 12 ? 2 : lang;
    String c = code == null ? "" : code.trim().toUpperCase(java.util.Locale.ROOT);
    if ("KERITES".equals(c) || "ZSALU".equals(c) || "TERKO".equals(c) || "TRAPEZ".equals(c)
        || "KISKAPU".equals(c) || "SZARNYAS".equals(c) || "TOLO".equals(c) || "USZO".equals(c)
        || "BETON".equals(c) || "PANEL3D".equals(c) || "ELECTRO".equals(c)) {
      return gcPv2ModuleTitle(c, l);
    }
    String[][] rows = new String[][]{
      {"GARAZS","Garázskapu","Garage door","Garagentor","Puerta de garaje","Porte de garage","车库门","Porta da garage","Porta de garagem","Brama garażowa","Garagedeur","Ușă de garaj","Гаражные ворота"},
      {"KORLAT","Korlát","Railing","Geländer","Barandilla","Garde-corps","栏杆","Ringhiera","Guarda-corpo","Balustrada","Leuning","Balustradă","Перила"},
      {"MOTOR","Motorhatározó","Motor selector","Motor-Auswahl","Selector de motor","Sélecteur de moteur","电机选择器","Selettore motore","Seletor de motor","Dobór napędu","Motorselectie","Selector motor","Подбор привода"},
      {"PROFIT","Profit kalkulátor","Profit calculator","Gewinnrechner","Calculadora de beneficio","Calculateur de profit","利润计算器","Calcolatore profitto","Calculadora de lucro","Kalkulator zysku","Winstcalculator","Calculator profit","Калькулятор прибыли"}
    };
    for (String[] r : rows) if (r[0].equals(c)) return r[l];
    return c;
  }

  private void gc284ApplyModuleClearTexts(java.util.HashMap<String,Object> m, int lang) {
    String[][] map = new String[][]{
      {"BTN_CLEAR_KERITESLEC","KERITES"}, {"BTN_CLEAR_ZSALUKO","ZSALU"},
      {"BTN_CLEAR_TERKO","TERKO"}, {"BTN_CLEAR_TRAPEZ","TRAPEZ"},
      {"BTN_CLEAR_KISKAPU","KISKAPU"}, {"BTN_CLEAR_SZARNYAS","SZARNYAS"},
      {"BTN_CLEAR_TOLO","TOLO"}, {"BTN_CLEAR_USZO","USZO"},
      {"BTN_CLEAR_GARAZS","GARAZS"}, {"BTN_CLEAR_KORLAT","KORLAT"},
      {"BTN_CLEAR_BETON","BETON"}, {"BTN_CLEAR_PANEL3D","PANEL3D"},
      {"BTN_CLEAR_MOTOR","MOTOR"}, {"BTN_CLEAR_PROFIT","PROFIT"},
      {"BTN_CLEAR_ELECTRO","ELECTRO"}
    };
    for (String[] x : map) gcV38Set(m, x[0], "Text", gc284ClearText(x[1], lang));
  }

  private void gc284ApplyProjectFieldTexts(java.util.HashMap<String,Object> m, int lang) {
    String[][] fields = new String[][]{
      {"LBL_PROJECT_FIELD_NAME","NAME"}, {"LBL_PROJECT_FIELD_CLIENT","CLIENT"},
      {"LBL_PROJECT_FIELD_SITE","SITE"}, {"LBL_PROJECT_FIELD_TYPE","TYPE"},
      {"LBL_PROJECT_STATUS","STATUS"}, {"LBL_PROJECT_FIELD_NOTE","NOTE"}
    };
    for (String[] x : fields) {
      Object c = m.get(x[0]);
      if (c != null) gcSetProperty(c, "Text", gcProjectUiText(x[1], lang) + ":");
    }
    Object empty = m.get("LBL_PROJECT_EMPTY");
    if (empty != null) gcSetProperty(empty, "Text", gcProjectUiText("EMPTY", lang));
  }

  private void gc284KeepProjectBarsWhite() {
    java.util.HashMap<String,Object> m = gcBuildNamedComponentMap();
    for (java.util.Map.Entry<String,Object> e : m.entrySet()) {
      String n = e.getKey() == null ? "" : e.getKey();
      if (!n.startsWith("HA_PV2_")) continue;
      Object c = e.getValue();
      if (c != null) try { gcSetProperty(c, "BackgroundColor", Integer.valueOf(0xFFFFFFFF)); } catch (Throwable ignored) { }
    }
  }

  // build285: exact drawing payload -> active project, through the existing CenterAction bridge.
  private String gc285CaptureDrawingPayload(String payload) {
    String pid = gcPv2ActiveId();
    if (pid == null || pid.length() == 0) return "";
    String raw = payload == null ? "" : payload.trim();
    if (raw.length() == 0) return "";
    int cut = raw.indexOf('|');
    String code = (cut < 0 ? raw : raw.substring(0, cut)).trim().toUpperCase(java.util.Locale.ROOT);
    boolean allowed = false;
    for (String x : new String[]{"KISKAPU","SZARNYAS","TOLO","USZO","KERITES","ZSALU","TERKO","TRAPEZ","PANEL3D","LEPCSO"}) {
      if (x.equals(code)) { allowed = true; break; }
    }
    if (!allowed) return "";

    // Avoid TinyDB growth when an unchanged drawing is reopened repeatedly.
    for (Object x : gcPv2Rows(GC_PV2_SNAPSHOTS)) {
      java.util.ArrayList<Object> r = mdList(x);
      if (r.size() < 13) continue;
      if (!pid.equals(mdString(r.get(1)))) continue;
      if (!code.equalsIgnoreCase(mdString(r.get(2)))) continue;
      if (!"DRAWING".equalsIgnoreCase(mdString(r.get(12)))) continue;
      if (raw.equals(mdString(r.get(11)))) return mdString(r.get(0));
      break;
    }

    int lang = (int) Math.round(PlatformLanguagePreference());
    String title = gcPv2ModuleTitle(code, lang);
    return ProjectV2AddSnapshot(code, title, "", "", "", 0.0d, 0.0d, 0.0d, raw, "DRAWING");
  }
