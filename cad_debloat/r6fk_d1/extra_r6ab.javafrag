
  @SimpleFunction(description = "R6AB folding motor drive wrapper. Preserves motor-presence check and gcFoldSafeMaxPercent clamp, then executes the R6Y exact chained drive.")
  public String FoldingMotorDriveR6ABJson(String gateId, String sceneJson, double requestedPercent) {
    try {
      String gid = gateId == null ? "" : gateId;
      if (gid.length() == 0 || "0".equals(gid) || "-1".equals(gid)) return error("GC_R6AB_NO_GATE");
      JSONObject scene = new JSONObject(sceneJson == null ? "{}" : sceneJson);
      JSONArray objects = scene.optJSONArray("objects");
      if (objects == null) return error("GC_R6AB_SCENE_MISSING");

      boolean motorFound = false;
      double safeMax = 100.0;
      for (int i = 0; i < objects.length(); i++) {
        JSONObject o = objects.optJSONObject(i);
        if (o == null) continue;
        JSONObject m = o.optJSONObject("metadata");
        if (m == null) continue;
        String mgid = String.valueOf(m.opt("gcFoldGateId"));
        if (!gid.equals(mgid)) continue;
        if ("FOLD_MOTOR".equals(m.optString("gcFoldHwRole", ""))) motorFound = true;
        if ("FOLDING_PANEL".equals(o.optString("type", "")) && m.optInt("gcFoldIndex", -1) == 0) {
          safeMax = m.optDouble("gcFoldSafeMaxPercent", 100.0);
        }
      }
      if (!motorFound) return error("GC_R6AB_MOTOR_MISSING");
      if (safeMax < 0.0) safeMax = 0.0;
      if (safeMax > 100.0) safeMax = 100.0;
      double effective = requestedPercent;
      if (effective < 0.0) effective = 0.0;
      if (effective > safeMax) effective = safeMax;

      JSONObject result = foldingDriveResultR6Y(gid, sceneJson, effective);
      if (!result.optBoolean("ok", false)) return result.toString();
      result.put("schema", "gatecraft.r6ab.fold-motor-drive.v1");
      result.put("requestedPercent", requestedPercent);
      result.put("safeMaxPercent", safeMax);
      result.put("percent", effective);
      result.put("motorFound", true);
      return result.toString();
    } catch (Throwable t) {
      return error("GC_R6AB_ENGINE_FAILED");
    }
  }
