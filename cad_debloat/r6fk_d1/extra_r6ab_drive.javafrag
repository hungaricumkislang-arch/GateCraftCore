
  @SimpleFunction(description = "R6AB dedicated folding motor drive. Requires same-gate FOLD_MOTOR and delegates to the exact R6Y/R6AA safe folding chain.")
  public String FoldingMotorDriveR6ABJson(String gateId, String sceneJson, double requestedPercent) {
    try {
      String gid = gateId == null ? "" : gateId;
      if (gid.length() == 0 || "0".equals(gid) || "-1".equals(gid)) return error("GC_R6AB_BAD_GATE");
      JSONObject scene = new JSONObject(sceneJson == null ? "{}" : sceneJson);
      JSONArray objects = scene.optJSONArray("objects");
      boolean motorFound = false;
      if (objects != null) {
        for (int i = 0; i < objects.length(); i++) {
          JSONObject o = objects.optJSONObject(i);
          if (o == null) continue;
          JSONObject m = o.optJSONObject("metadata");
          if (m == null) continue;
          if (sameId(m.opt("gcFoldGateId"), gid) && "FOLD_MOTOR".equals(m.optString("gcFoldHwRole", ""))) {
            motorFound = true;
            break;
          }
        }
      }
      if (!motorFound) return error("GC_R6AB_MOTOR_REQUIRED");
      return FoldingDriveR6YJson(gid, scene.toString(), requestedPercent);
    } catch (Throwable t) {
      return error("GC_R6AB_ENGINE_FAILED");
    }
  }
