
  @SimpleFunction(description = "R6S planar swing actuator inverse solve. Returns solved 0..90 leaf angle in degrees, or -1 when mounting is non-monotonic.")
  public double SolveSwingActuatorAngleR6S(double commandPercent,
      double hingeX, double hingeZ, double axisY, double frontRadius,
      double rearX, double rearZ) {
    double l0 = swingActuatorLengthR6S(0.0, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
    double l25 = swingActuatorLengthR6S(22.5, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
    double l50 = swingActuatorLengthR6S(45.0, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
    double l75 = swingActuatorLengthR6S(67.5, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
    double l90 = swingActuatorLengthR6S(90.0, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
    boolean inc = l0 <= l25 && l25 <= l50 && l50 <= l75 && l75 <= l90;
    boolean dec = l0 >= l25 && l25 >= l50 && l50 >= l75 && l75 >= l90;
    if (!inc && !dec) return -1.0;
    double cmd = Math.max(0.0, Math.min(100.0, commandPercent));
    double target = l0 + (l90 - l0) * (cmd / 100.0);
    double low = 0.0, high = 90.0;
    for (int i = 0; i < 12; i++) {
      double mid = (low + high) * 0.5;
      double lm = swingActuatorLengthR6S(mid, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
      if (inc) {
        if (lm < target) low = mid; else high = mid;
      } else {
        if (lm > target) low = mid; else high = mid;
      }
    }
    return (low + high) * 0.5;
  }

  @SimpleFunction(description = "R6S planar swing actuator length helper.")
  public double SwingActuatorLengthR6S(double angleDeg,
      double hingeX, double hingeZ, double axisY, double frontRadius,
      double rearX, double rearZ) {
    return swingActuatorLengthR6S(angleDeg, hingeX, hingeZ, axisY, frontRadius, rearX, rearZ);
  }

  private static double swingActuatorLengthR6S(double angleDeg,
      double hingeX, double hingeZ, double axisY, double frontRadius,
      double rearX, double rearZ) {
    double th = Math.toRadians(angleDeg);
    double fx = hingeX + axisY * frontRadius * Math.cos(th);
    double fz = hingeZ - frontRadius * Math.sin(th);
    double dx = fx - rearX;
    double dz = fz - rearZ;
    return Math.sqrt(dx * dx + dz * dz);
  }
