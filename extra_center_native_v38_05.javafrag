    else if("BUS_CAT_SAVE".equals(a))BusinessCatalogSaveFromScreen();else if("BUS_CAT_DELETE".equals(a))BusinessCatalogDeleteFromScreen();else if("BUS_CAT_SELECT".equals(a))BusinessCatalogSelectFromScreen(gcCSelIndex(m,"LV_BUS_CATALOG"));else if("BUS_COST_SAVE".equals(a))BusinessCostSaveFromScreen();else if("BUS_COST_DELETE".equals(a))BusinessCostDeleteFromScreen();else if("BUS_COST_SELECT".equals(a))BusinessCostSelectFromScreen(gcCSelIndex(m,"LV_BUS_COSTS"));else if("BUS_TIMER_START".equals(a))BusinessTimerStartFromScreen();else if("BUS_TIMER_STOP".equals(a))BusinessTimerStopFromScreen();else if("BUS_TIME_ADD".equals(a))BusinessTimeAddFromScreen();else if("BUS_REFRESH".equals(a))BusinessRefreshScreen();else if("BUS_TEMPLATE".equals(a))BusinessTemplateApplyFromScreen();
    else if("ENG_PROFILE_TOGGLE".equals(a))gcCVisible(m,"VA_ENG_PROFILE",!gcCVis(m,"VA_ENG_PROFILE"));else if("ENG_PROFILE_SAVE".equals(a))gcCSaveEngineeringProfile(m);else if("ENG_CONFIGURE".equals(a))CenterEngineeringConfigure();else if("ENG_CALC".equals(a))CenterEngineeringCalculate();else if("ENG_SAVE_A".equals(a))CenterEngineeringSaveSide("A");else if("ENG_SAVE_B".equals(a))CenterEngineeringSaveSide("B");else if("ENG_COMPARE".equals(a))CenterEngineeringCompare();
    else if(a.startsWith("PV2_SAVE|")){String code=a.substring(9);ProjectV2CaptureAndApply(code,"");}
    else if(a.startsWith("PV2_DRAW|")){gc285CaptureDrawingPayload(a.substring(9));}
    else if("PV2_REFRESH".equals(a))ProjectV2RefreshUi();
    else if(a.startsWith("PV2_DASH|"))ProjectV2ApplyDashboardSection(a.substring(9));
    else if("PV2_ACTIVATE_SELECTED".equals(a)){int idx=gcCSelIndex(m,"LV_PROJECTS");java.util.ArrayList<Object> rows=gcProjectRows();if(idx>=1&&idx<=rows.size()){java.util.ArrayList<Object> r=mdList(rows.get(idx-1));if(r.size()>0)ProjectV2SetActive(mdString(r.get(0)));}ProjectV2RefreshUi();}
    gcCApplyTheme(m);
  }
  @SimpleFunction(description="Handles the native GateCraft Center backup confirmation dialog.") public void CenterBackupChoice(String choice){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();if(!BackupUiText("YES",gcCLang()).equals(choice)){gcCenterPendingBackup="";gcCenterPendingBackupMode="";return;}boolean ok=false;if("FILE".equals(gcCenterPendingBackupMode))ok=BackupRestoreUri(gcCenterPendingBackup);else if("SNAPSHOT".equals(gcCenterPendingBackupMode))ok=BackupRestoreSnapshot();String key=ok?("SNAPSHOT".equals(gcCenterPendingBackupMode)?"SNAPSHOT_OK":"RESTORE_OK"):"RESTORE_FAIL";gcCAlert(m,BackupUiText(key,gcCLang())+(ok?"":"\n"+BackupLastError()));gcCenterPendingBackup="";gcCenterPendingBackupMode="";if(ok){gcCApplyTexts(m);gcCApplyTheme(m);}}
