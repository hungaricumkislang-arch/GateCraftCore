  private java.util.HashMap<String, String[]> gcLang6Cache = null;
  private String gcLang6LoadError = "";

  private synchronized void gcEnsureLang6() {
    if (gcLang6Cache != null) return;
    java.util.HashMap<String, String[]> loaded = new java.util.HashMap<String, String[]>();
    java.io.InputStream raw = null;
    java.util.zip.GZIPInputStream gzip = null;
    try {
      raw = com.google.appinventor.components.runtime.util.MediaUtil.openMedia(form, "gc_lang6.dat");
      gzip = new java.util.zip.GZIPInputStream(raw);
      java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
      byte[] buffer = new byte[8192];
      int n;
      while ((n = gzip.read(buffer)) >= 0) {
        if (n > 0) out.write(buffer, 0, n);
      }
      String data = new String(out.toByteArray(), "UTF-8");
      java.util.ArrayList<String> fields = new java.util.ArrayList<String>();
      int start = 0;
      for (int i = 0; i <= data.length(); i++) {
        if (i == data.length() || data.charAt(i) == 0) {
          fields.add(data.substring(start, i));
          start = i + 1;
        }
      }
      if (fields.size() % 7 != 0) {
        throw new java.io.IOException("Invalid gc_lang6.dat field count: " + fields.size());
      }
      for (int i = 0; i < fields.size(); i += 7) {
        String key = fields.get(i);
        String[] texts = new String[6];
        for (int lang = 0; lang < 6; lang++) texts[lang] = fields.get(i + 1 + lang);
        loaded.put(key, texts);
      }
      gcLang6LoadError = "";
    } catch (Throwable ex) {
      gcLang6LoadError = ex.getClass().getSimpleName() + ": " + String.valueOf(ex.getMessage());
      loaded.clear();
    } finally {
      try { if (gzip != null) gzip.close(); else if (raw != null) raw.close(); } catch (Throwable ignored) { }
    }
    gcLang6Cache = loaded;
  }

  @SimpleFunction(description = "Returns one exact GateCraft six-language text stored in the bundled compressed gc_lang6.dat asset. Language index is 1..6; invalid index falls back to Hungarian.")
  public String Lang6(String key, double languageIndex) {
    gcEnsureLang6();
    if (gcLang6Cache == null || key == null) return "";
    String[] texts = gcLang6Cache.get(key);
    if (texts == null || texts.length != 6) return "";
    int lang = (int) Math.round(languageIndex);
    if (lang < 1 || lang > 6) lang = 1;
    String value = texts[lang - 1];
    return value == null ? "" : value;
  }

  @SimpleFunction(description = "Returns the number of loaded GateCraft six-language asset records. Zero means the language asset did not load.")
  public double Lang6Count() {
    gcEnsureLang6();
    return gcLang6Cache == null ? 0.0d : gcLang6Cache.size();
  }

  @SimpleFunction(description = "Returns the last GateCraft six-language asset load error, or an empty string when the asset loaded successfully.")
  public String Lang6Error() {
    gcEnsureLang6();
    return gcLang6LoadError == null ? "" : gcLang6LoadError;
  }
