  private void gcV38ApplyModernExtras() {
    if(form==null)return;
    String screen=form.getClass().getSimpleName();
    if(!("Screen_ElectroPro".equals(screen)||"Screen_LepcsoPro".equals(screen)||"Screen_MuszakiSeged".equals(screen)||"Screen_MotorDiag".equals(screen)))return;
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    String theme=gcPlatformString(gcPlatformTinyGet("kozos_tema","default"),"default").trim().toLowerCase(java.util.Locale.ROOT);
    boolean forge="marka2".equals(theme);
    int bg=forge?0xFF181818:0xFFFFFFFF, fg=forge?0xFFFFFFFF:0xFF000000;
    int lang=(int)Math.round(PlatformLanguagePreference());if(lang<1||lang>12)lang=2;
    String header="",back="",title="",mini="",cover="",coverTitle="",coverLoading="",moduleKey="";
    if("Screen_ElectroPro".equals(screen)){header="HA_EP_Header";back="BTN_EP_Back";title="LBL_EP_PageTitle";cover="VA_EP_TAKARO";coverTitle="LBL_EP_TAKARO_TITLE";coverLoading="LBL_EP_TAKARO_LOADING";moduleKey="ELECTRO";}
    else if("Screen_LepcsoPro".equals(screen)){header="HA_SP_Header";back="BTN_SP_Back";title="LBL_SP_PageTitle";cover="VA_SP_TAKARO";coverTitle="LBL_SP_TAKARO_TITLE";coverLoading="LBL_SP_TAKARO_LOADING";moduleKey="STAIR";}
    else if("Screen_MuszakiSeged".equals(screen)){header="HA_TG_Header";back="BTN_TG_Back";title="LBL_TG_PageTitle";mini="LBL_TG_ContextMini";cover="VA_TG_TAKARO";coverTitle="LBL_TG_TAKARO_TITLE";coverLoading="LBL_TG_TAKARO_LOADING";moduleKey="TECH";}
    else {header="HA_MD_Header";back="BTN_MD_Back";title="LBL_MD_PageTitle";mini="LBL_MD_ControllerMini";cover="VA_MD_TAKARO";coverTitle="LBL_MD_TAKARO_TITLE";coverLoading="LBL_MD_TAKARO_LOADING";moduleKey="MOTOR";}
    gcV38Set(m,header,"BackgroundColor",Integer.valueOf(bg));
    for(String n:new String[]{title,mini})if(n.length()>0){gcV38Set(m,n,"BackgroundColor",Integer.valueOf(0x00FFFFFF));gcV38Set(m,n,"TextColor",Integer.valueOf(fg));}
    gcV38Set(m,back,"Visible",Boolean.TRUE);gcV38Set(m,back,"Text","‹");gcV38Set(m,back,"Width",Integer.valueOf(-1015));gcV38Set(m,back,"Image",gcV35BackImage(theme));gcV38Set(m,back,"TextColor",Integer.valueOf(fg));gcV38Set(m,back,"BackgroundColor",Integer.valueOf(0x00FFFFFF));
    gcV38Set(m,cover,"BackgroundColor",Integer.valueOf(bg));gcV38Set(m,coverTitle,"BackgroundColor",Integer.valueOf(0x00FFFFFF));gcV38Set(m,coverLoading,"BackgroundColor",Integer.valueOf(0x00FFFFFF));gcV38Set(m,coverTitle,"TextColor",Integer.valueOf(fg));gcV38Set(m,coverLoading,"TextColor",Integer.valueOf(fg));gcV38Set(m,coverTitle,"Text",gcV38L(moduleKey,lang));gcV38Set(m,coverLoading,"Text",gcV38L("LOADING",lang));
  }

  private void gcV38ApplyScreen1Texts() {
    if(form==null||!"Screen1".equals(form.getClass().getSimpleName()))return;
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();int l=(int)Math.round(PlatformLanguagePreference());if(l<1||l>12)l=2;
