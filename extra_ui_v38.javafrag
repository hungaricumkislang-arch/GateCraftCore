    gcV38Set(m,"BTN_MODULE_CLEAR_BACK","Text",gcV38L("BACK",l));
  }

  private void gcV38PrepareScreen1Extras() {
    if(form==null||!"Screen1".equals(form.getClass().getSimpleName()))return;
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();String theme=gcPlatformString(gcPlatformTinyGet("kozos_tema","default"),"default").trim().toLowerCase(java.util.Locale.ROOT);int normal=gcV34NormalText(theme),bt=gcV35ButtonText(theme);String img=gcV34ButtonImage(theme);
    gcV38ApplyScreen1Texts();
    for(java.util.Map.Entry<String,Object> e:m.entrySet()){
      String n=e.getKey()==null?"":e.getKey();String u=n.toUpperCase(java.util.Locale.ROOT);Object c=e.getValue();if(c==null)continue;
      boolean clear=u.contains("MODULE_CLEAR")||u.startsWith("BTN_CLEAR_");
      if(!clear)continue;
      if(c instanceof com.google.appinventor.components.runtime.Button){gcV38Set(m,n,"Image",img);gcV38Set(m,n,"TextColor",Integer.valueOf(bt));gcV38Set(m,n,"BackgroundColor",Integer.valueOf(0x00FFFFFF));}
      else if(c instanceof com.google.appinventor.components.runtime.Label){gcV38Set(m,n,"BackgroundColor",Integer.valueOf(0x00FFFFFF));gcV38Set(m,n,"TextColor",Integer.valueOf(normal));}
      else if(c instanceof com.google.appinventor.components.runtime.HorizontalArrangement||c instanceof com.google.appinventor.components.runtime.VerticalArrangement||c instanceof com.google.appinventor.components.runtime.VerticalScrollArrangement){gcV38Set(m,n,"BackgroundColor",Integer.valueOf(0x00FFFFFF));}
    }
    gcV38Set(m,"BTN_GATECRAFT_CENTER_OPEN","Image",img);gcV38Set(m,"BTN_GATECRAFT_CENTER_OPEN","TextColor",Integer.valueOf(bt));
  }
