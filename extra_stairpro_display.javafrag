  // ------------------------------------------------------------------
  // StairPro localized display helpers (v2.9)
  // Keeps multiline result formatting and candidate rendering out of YAIL.
  // ------------------------------------------------------------------
  private String spL(int lang,String hu,String en,String de,String es,String fr,String zh){switch(lang){case 2:return en;case 3:return de;case 4:return es;case 5:return fr;case 6:return zh;default:return hu;}}
  private String spN(double v,int n){return String.valueOf(spRound(v,n));}

  @SimpleFunction(description="StairPro quick-design localized ListView rows.")
  public YailList StairQuickDisplay(YailList options,double languageIndex){int lang=tgLang(languageIndex);java.util.ArrayList<Object>out=new java.util.ArrayList<Object>();if(options!=null)for(int i=0;i<options.size();i++){java.util.ArrayList<Object>a=mdList(options.getObject(i));if(a.size()<10)continue;String st=mdString(a.get(9));String stx="PASS_PRELIMINARY".equals(st)?spL(lang,"Kedvező geometriai javaslat","Favourable geometric option","Günstiger Geometrievorschlag","Propuesta geométrica favorable","Proposition géométrique favorable","较合适的几何方案"):"STEEP".equals(st)?spL(lang,"Meredekebb kialakítás","Steeper arrangement","Steilere Ausführung","Configuración más inclinada","Configuration plus raide","较陡的方案"):spL(lang,"Profil ellenőrzést igényel","Profile check required","Profilprüfung erforderlich","Requiere comprobación de perfil","Contrôle du profil requis","需要检查配置文件");out.add(spN(spD(a.get(0),0),0)+" "+spL(lang,"fellépés","risers","Steigungen","contrahuellas","hauteurs","级")+" | "+spN(spD(a.get(2),0),1)+" mm | "+spN(spD(a.get(3),0),1)+" mm | "+spN(spD(a.get(6),0),1)+"° | "+stx);}return YailList.makeList(out);}

  @SimpleFunction(description="StairPro localized geometry summary.")
  public String StairGeometryText(YailList g,double languageIndex){int l=tgLang(languageIndex);if(!spListB(g,1,false))return spL(l,"Nincs érvényes geometria.","No valid geometry.","Keine gültige Geometrie.","No hay geometría válida.","Aucune géométrie valide.","没有有效的楼梯几何数据。");return spL(l,"Fellépések száma: ","Riser count: ","Steigungen: ","Número de contrahuellas: ","Nombre de hauteurs : ","级数：")+spN(spListD(g,5,0),0)+"\n"+spL(l,"Belépők száma: ","Tread count: ","Auftritte: ","Número de huellas: ","Nombre de girons : ","踏步数：")+spN(spListD(g,6,0),0)+"\n"+spL(l,"Fellépőmagasság: ","Riser height: ","Steigungshöhe: ","Altura de contrahuella: ","Hauteur de marche : ","级高：")+spN(spListD(g,7,0),1)+" mm\n"+spL(l,"Belépőmélység: ","Going: ","Auftrittstiefe: ","Huella: ","Giron : ","踏步深度：")+spN(spListD(g,8,0),1)+" mm\n"+spL(l,"Vízszintes hossz: ","Horizontal run: ","Lauflänge: ","Desarrollo horizontal: ","Reculement : ","水平长度：")+spN(spListD(g,9,0),1)+" mm\n"+spL(l,"Ferde hossz: ","Slope length: ","Schräglänge: ","Longitud inclinada: ","Longueur inclinée : ","斜长：")+spN(spListD(g,10,0),1)+" mm\n"+spL(l,"Hajlásszög: ","Angle: ","Neigungswinkel: ","Ángulo: ","Angle : ","倾角：")+spN(spListD(g,11,0),1)+"°\n2R+G: "+spN(spListD(g,12,0),1)+" mm"+(spListD(g,13,-1)>=0?"\n"+spL(l,"Becsült szabad belmagasság: ","Estimated headroom: ","Geschätzte Kopfhöhe: ","Altura libre estimada: ","Échappée estimée : ","估算净空高度：")+spN(spListD(g,13,0),1)+" mm":"");}

  @SimpleFunction(description="StairPro localized landing/two-flight summary.")
  public String StairLandingText(YailList x,double languageIndex){int l=tgLang(languageIndex);if(!spListB(x,1,false))return spL(l,"Nincs érvényes kétkarú geometria.","No valid two-flight geometry.","Keine gültige zweiläufige Geometrie.","No hay geometría válida de dos tramos.","Aucune géométrie à deux volées valide.","没有有效的双跑楼梯几何数据。");return spL(l,"1. kar fellépései: ","Flight 1 risers: ","Steigungen Lauf 1: ","Contrahuellas tramo 1: ","Hauteurs volée 1 : ","第一跑级数：")+spN(spListD(x,4,0),0)+"\n"+spL(l,"2. kar fellépései: ","Flight 2 risers: ","Steigungen Lauf 2: ","Contrahuellas tramo 2: ","Hauteurs volée 2 : ","第二跑级数：")+spN(spListD(x,5,0),0)+"\n"+spL(l,"Fellépőmagasság: ","Riser height: ","Steigungshöhe: ","Altura de contrahuella: ","Hauteur de marche : ","级高：")+spN(spListD(x,8,0),1)+" mm\n"+spL(l,"1. kar vízszintes hossza: ","Flight 1 run: ","Lauflänge Lauf 1: ","Desarrollo tramo 1: ","Reculement volée 1 : ","第一跑水平长度：")+spN(spListD(x,9,0),1)+" mm\n"+spL(l,"2. kar vízszintes hossza: ","Flight 2 run: ","Lauflänge Lauf 2: ","Desarrollo tramo 2: ","Reculement volée 2 : ","第二跑水平长度：")+spN(spListD(x,10,0),1)+" mm\n"+spL(l,"1. kar ferde hossza: ","Flight 1 slope: ","Schräglänge Lauf 1: ","Longitud inclinada tramo 1: ","Longueur volée 1 : ","第一跑斜长：")+spN(spListD(x,11,0),1)+" mm\n"+spL(l,"2. kar ferde hossza: ","Flight 2 slope: ","Schräglänge Lauf 2: ","Longitud inclinada tramo 2: ","Longueur volée 2 : ","第二跑斜长：")+spN(spListD(x,12,0),1)+" mm";}

  @SimpleFunction(description="StairPro localized steel estimate summary.")
  public String StairSteelText(YailList x,double languageIndex){int l=tgLang(languageIndex);if(!spListB(x,1,false))return spL(l,"Acélszámításhoz előbb érvényes geometria kell.","Valid geometry is required before steel calculation.","Für die Stahlberechnung ist zuerst eine gültige Geometrie erforderlich.","Se necesita una geometría válida antes del cálculo de acero.","Une géométrie valide est requise avant le calcul acier.","钢结构计算前需要有效的楼梯几何数据。");return spL(l,"Főtartó pályahossza: ","Stringer path: ","Wangenlänge: ","Longitud de zanca: ","Longueur du limon : ","梯梁路径长度：")+spN(spListD(x,2,0),1)+" mm\n"+spL(l,"Vásárolandó főtartó: ","Stringer purchase length: ","Einkaufslänge Wange: ","Longitud de compra de zanca: ","Longueur de limon à acheter : ","梯梁采购长度：")+spN(spListD(x,3,0),3)+" m\n"+spL(l,"Foktartók: ","Step supports: ","Stufenträger: ","Soportes de peldaño: ","Supports de marche : ","踏步支撑数量：")+spN(spListD(x,4,0),0)+"\n"+spL(l,"Foktartó összhossz: ","Support total length: ","Gesamtlänge Stufenträger: ","Longitud total de soportes: ","Longueur totale des supports : ","踏步支撑总长度：")+spN(spListD(x,5,0),3)+" m\n"+spL(l,"Fokfelület tartalékkal: ","Tread area with waste: ","Stufenfläche inkl. Verschnitt: ","Área de peldaños con merma: ","Surface de marches avec pertes : ","含损耗踏步面积：")+spN(spListD(x,6,0),3)+" m²\n"+spL(l,"Becsült tömeg: ","Estimated weight: ","Geschätztes Gewicht: ","Peso estimado: ","Poids estimé : ","估算重量：")+spN(spListD(x,7,0),2)+" kg\n"+spL(l,"Becsült hegesztési hossz: ","Estimated weld length: ","Geschätzte Schweißnahtlänge: ","Longitud de soldadura estimada: ","Longueur de soudure estimée : ","估算焊缝长度：")+spN(spListD(x,8,0),2)+" m\n"+spL(l,"Becsült anyagköltség: ","Estimated material cost: ","Geschätzte Materialkosten: ","Coste de material estimado: ","Coût matière estimé : ","估算材料成本：")+spN(spListD(x,9,0),2);}

  @SimpleFunction(description="StairPro localized concrete estimate summary.")
  public String StairConcreteText(YailList x,double languageIndex){int l=tgLang(languageIndex);if(!spListB(x,1,false))return spL(l,"Betonszámításhoz előbb érvényes geometria kell.","Valid geometry is required before concrete calculation.","Für die Betonberechnung ist zuerst eine gültige Geometrie erforderlich.","Se necesita una geometría válida antes del cálculo de hormigón.","Une géométrie valide est requise avant le calcul béton.","混凝土计算前需要有效的楼梯几何数据。");return spL(l,"Lépcsőkar becsült betonja: ","Estimated stair slab concrete: ","Geschätzter Beton Treppenlauf: ","Hormigón estimado del tramo: ","Béton estimé de la volée : ","梯段估算混凝土量：")+spN(spListD(x,2,0),4)+" m³\n"+spL(l,"Fokékek becsült betonja: ","Estimated step wedges: ","Geschätzte Stufenkeile: ","Hormigón estimado de peldaños: ","Béton estimé des marches : ","踏步楔块估算混凝土量：")+spN(spListD(x,3,0),4)+" m³\n"+spL(l,"Pihenő betonja: ","Landing concrete: ","Podestbeton: ","Hormigón del rellano: ","Béton du palier : ","平台混凝土量：")+spN(spListD(x,4,0),4)+" m³\n"+spL(l,"Összes beton: ","Total concrete: ","Beton gesamt: ","Hormigón total: ","Béton total : ","混凝土总量：")+spN(spListD(x,5,0),4)+" m³\n"+spL(l,"Tartalékkal: ","With waste: ","Mit Zuschlag: ","Con merma: ","Avec marge : ","含余量：")+spN(spListD(x,6,0),4)+" m³\n"+spL(l,"Becsült zsaluzási felület: ","Estimated formwork area: ","Geschätzte Schalungsfläche: ","Superficie de encofrado estimada: ","Surface de coffrage estimée : ","估算模板面积：")+spN(spListD(x,7,0),3)+" m²";}

  @SimpleFunction(description="StairPro localized railing estimate summary.")
  public String StairRailingText(YailList x,double languageIndex){int l=tgLang(languageIndex);if(!spListB(x,1,false))return spL(l,"Korlátszámításhoz előbb érvényes geometria kell.","Valid geometry is required before railing calculation.","Für die Geländerberechnung ist zuerst eine gültige Geometrie erforderlich.","Se necesita una geometría válida antes del cálculo de barandilla.","Une géométrie valide est requise avant le calcul du garde-corps.","栏杆计算前需要有效的楼梯几何数据。");return spL(l,"Ferde korláthossz: ","Slope railing length: ","Schräge Geländerlänge: ","Longitud de barandilla inclinada: ","Longueur de garde-corps incliné : ","斜段栏杆长度：")+spN(spListD(x,2,0),3)+" m\n"+spL(l,"Kapaszkodó teljes hossza: ","Total handrail length: ","Handlauflänge gesamt: ","Longitud total de pasamanos: ","Longueur totale de main courante : ","扶手总长度：")+spN(spListD(x,3,0),3)+" m\n"+spL(l,"Oszlopok száma: ","Post count: ","Pfostenanzahl: ","Número de postes: ","Nombre de poteaux : ","立柱数量：")+spN(spListD(x,4,0),0)+"\n"+spL(l,"Tényleges oszloptáv: ","Actual post spacing: ","Tatsächlicher Pfostenabstand: ","Separación real de postes: ","Entraxe réel des poteaux : ","实际立柱间距：")+spN(spListD(x,5,0),1)+" mm\n"+spL(l,"Pálcák száma: ","Baluster count: ","Stabanzahl: ","Número de barrotes: ","Nombre de barreaux : ","竖杆数量：")+spN(spListD(x,6,0),0)+"\n"+spL(l,"Becsült profilhossz: ","Estimated profile length: ","Geschätzte Profillänge: ","Longitud de perfil estimada: ","Longueur de profil estimée : ","估算型材长度：")+spN(spListD(x,7,0),3)+" m\n"+spL(l,"Becsült anyagköltség: ","Estimated material cost: ","Geschätzte Materialkosten: ","Coste de material estimado: ","Coût matière estimé : ","估算材料成本：")+spN(spListD(x,8,0),2);}

  @SimpleFunction(description="StairPro localized cost summary.")
  public String StairCostText(YailList x,double languageIndex){int l=tgLang(languageIndex);return spL(l,"Anyagköltség: ","Material cost: ","Materialkosten: ","Coste de material: ","Coût matière : ","材料成本：")+spN(spListD(x,1,0),2)+"\n"+spL(l,"Munkadíj: ","Labour: ","Arbeitskosten: ","Mano de obra: ","Main-d’œuvre : ","人工费：")+spN(spListD(x,2,0),2)+"\n"+spL(l,"Önköltség: ","Direct cost: ","Selbstkosten: ","Coste directo: ","Coût direct : ","直接成本：")+spN(spListD(x,3,0),2)+"\n"+spL(l,"Profit: ","Profit: ","Gewinn: ","Beneficio: ","Marge : ","利润：")+spN(spListD(x,4,0),2)+"\n"+spL(l,"Nettó ajánlat: ","Net offer: ","Nettoangebot: ","Oferta neta: ","Offre nette : ","未税报价：")+spN(spListD(x,5,0),2)+"\n"+spL(l,"Adó: ","Tax: ","Steuer: ","Impuesto: ","Taxe : ","税额：")+spN(spListD(x,6,0),2)+"\n"+spL(l,"Bruttó ajánlat: ","Gross offer: ","Bruttoangebot: ","Oferta bruta: ","Offre TTC : ","含税报价：")+spN(spListD(x,7,0),2);}

  @SimpleFunction(description="StairPro consolidated localized result/export text.")
  public String StairResultText(String projectName,YailList geometry,YailList landing,YailList steel,YailList concrete,YailList railing,YailList cost,double languageIndex){int l=tgLang(languageIndex);StringBuilder sb=new StringBuilder();sb.append("GateCraft – StairPro / LépcsőPro\n");if(projectName!=null&&projectName.trim().length()>0)sb.append(spL(l,"Projekt: ","Project: ","Projekt: ","Proyecto: ","Projet : ","项目：")).append(projectName.trim()).append("\n\n");sb.append(spL(l,"GEOMETRIA","GEOMETRY","GEOMETRIE","GEOMETRÍA","GÉOMÉTRIE","几何")).append("\n").append(StairGeometryText(geometry,languageIndex));if(spListB(landing,1,false))sb.append("\n\n").append(spL(l,"PIHENŐ / KÉT KAR","LANDING / TWO FLIGHTS","PODEST / ZWEI LÄUFE","RELLANO / DOS TRAMOS","PALIER / DEUX VOLÉES","平台 / 双跑")).append("\n").append(StairLandingText(landing,languageIndex));if(spListB(steel,1,false))sb.append("\n\n").append(spL(l,"ACÉL","STEEL","STAHL","ACERO","ACIER","钢结构")).append("\n").append(StairSteelText(steel,languageIndex));if(spListB(concrete,1,false))sb.append("\n\n").append(spL(l,"BETON","CONCRETE","BETON","HORMIGÓN","BÉTON","混凝土")).append("\n").append(StairConcreteText(concrete,languageIndex));if(spListB(railing,1,false))sb.append("\n\n").append(spL(l,"KORLÁT","RAILING","GELÄNDER","BARANDILLA","GARDE-CORPS","栏杆")).append("\n").append(StairRailingText(railing,languageIndex));if(cost!=null&&cost.size()>=7)sb.append("\n\n").append(spL(l,"KÖLTSÉG","COST","KOSTEN","COSTE","COÛT","成本")).append("\n").append(StairCostText(cost,languageIndex));sb.append("\n\n").append(spL(l,"A számítás geometriai és mennyiségi becslés. A teherhordó szerkezet, rögzítés, korlát, vasalás és helyi megfelelőség végleges szakmai ellenőrzést igényel.","Geometry and quantities are estimates. Load-bearing structure, fixings, railing, reinforcement and local compliance require final professional verification.","Geometrie und Mengen sind Schätzwerte. Tragwerk, Befestigung, Geländer, Bewehrung und örtliche Anforderungen müssen fachlich abschließend geprüft werden.","La geometría y las cantidades son estimaciones. La estructura portante, fijaciones, barandilla, armadura y normativa local requieren una verificación profesional final.","La géométrie et les quantités sont des estimations. La structure porteuse, les fixations, le garde-corps, le ferraillage et la conformité locale nécessitent une vérification professionnelle finale.","几何和数量为估算值。承重结构、固定方式、栏杆、钢筋配置及当地合规性必须由专业人员最终核验。"));return sb.toString();}
