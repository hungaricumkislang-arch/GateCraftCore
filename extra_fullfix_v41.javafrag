  @SimpleFunction(description="Shows a localized GateCraft validation warning without changing calculation values.")
  public void ValidationAlert(String code) {
    int lang=(int)Math.round(PlatformLanguagePreference());
    String c=code==null?"":code.toUpperCase(java.util.Locale.ROOT);
    String msg="OVERLAP".equals(c)?gcV41Tr("OVERLAP",lang):gcV41Tr("POSITIVE",lang);
    try { android.widget.Toast.makeText(form, msg, android.widget.Toast.LENGTH_LONG).show(); } catch(Throwable ignored) {}
  }

  private String[] gcV41EngineeringLabels(int t, int lang) {
    switch(t) {
      case 1:return new String[]{gcV41Tr("BUDGET",lang),gcV41Tr("UNIT_PRICE",lang)};
      case 2:return new String[]{"M_allow [kNm]","h [m]","v_wind [m/s]","Cd","solidity [0..1]"};
      case 3:return new String[]{"F_limit [N]","v_wind [m/s]","Cd","solidity [0..1]"};
      case 4:return new String[]{gcV41Tr("MASS",lang),"μ_roll","slope [%]",gcV41Tr("START_FACTOR",lang)};
      case 5:return new String[]{gcV41Tr("COST",lang),gcV41Tr("TARGET_MARGIN",lang)};
      case 6:return new String[]{"B [mm]","H [mm]",gcV41Tr("MASS",lang),gcV41Tr("HINGES",lang),gcV41Tr("HINGE_SPACING",lang),"v_wind [m/s]","Cd","solidity [0..1]","M_allow [kNm]"};
      case 7:return new String[]{gcV41Tr("MASS",lang),"B [mm]","H [mm]","μ_roll","slope [%]",gcV41Tr("START_FACTOR",lang),gcV41Tr("ROLLERS",lang),"v_wind [m/s]","Cd","wind opposition [0..1]","speed [m/s]","η"};
      case 8:return new String[]{gcV41Tr("OPENING",lang),"L_total [mm]",gcV41Tr("MASS",lang),gcV41Tr("ROLLER_SPACING",lang),"cg front [mm]","H [mm]","v_wind [m/s]","Cd","solidity [0..1]"};
      case 9:return new String[]{gcV41Tr("TYPE_GATE",lang),gcV41Tr("MASS",lang),"B [mm]","H [mm]","μ_roll","slope [%]","v_wind [m/s]","Cd","solidity [0..1]","lever [mm]",gcV41Tr("START_FACTOR",lang),"speed [m/s]","η","cycles/h","cycle [s]"};
      case 10:return new String[]{"h [m]",gcV41Tr("POST_SPACING",lang),"L [m]","v_wind [m/s]","Cd","solidity [0..1]","M_allow [kNm]","σ_allow [MPa]"};
      case 11:return new String[]{"L [m]","W [m]","D/H [m]",gcV41Tr("COUNT",lang),gcV41Tr("RESERVE",lang),"rebar [kg/m³]","truck [m³]","bottom form [0/1]"};
      case 12:return new String[]{"wall L [m]","wall H [m]","block L [mm]","block H [mm]",gcV41Tr("RESERVE",lang),"corners [db]","free ends [db]","vertical spacing [mm]","horizontal bars/course","pillars [db]","bars/pillar","fill [L/block]"};
      case 13:return new String[]{gcV41Tr("AREA",lang),gcV41Tr("EXCAVATION",lang),gcV41Tr("SUBBASE",lang),"subbase ρ [t/m³]","loose factor",gcV41Tr("BEDDING",lang),"bedding ρ [t/m³]","paver reserve [%]","geotextile [%]","joint sand [kg/m²]",gcV41Tr("EDGE",lang)};
      case 14:return new String[]{"m1 [kg]","x1 [mm]","y1 [mm]","z1 [mm]","m2 [kg]","x2 [mm]","y2 [mm]","z2 [mm]","m3 [kg]","x3 [mm]","y3 [mm]","z3 [mm]"};
      case 15:return new String[]{"B [mm]","H [mm]","panel [kg/m²]","hardware [kg]","balance [%]","friction ratio","drum r [mm]","head avail [mm]","head req [mm]","side avail [mm]","side req [mm]"};
      case 16:return new String[]{"L [mm]","max post [mm]","post W [mm]","baluster W [mm]","max clear gap [mm]","sides [db]"};
      case 17:return new String[]{"hall L [m]","hall W [m]","eave H [m]","frame spacing [m]","roof slope [°]","purlin spacing [m]","v_wind [m/s]","wall Cd","snow [kN/m²]","σ_allow [MPa]"};
      case 18:return new String[]{"Iz_base [A]","Ib [A]","In [A]","kT","kG","kO","start multiplier","phase [1/3]","U [V]","L_one-way [m]","R [mΩ/m]","X [mΩ/m]","cosφ"};
      case 19:return new String[]{gcV41Tr("PROCESS",lang),"ISO 4063 ref",gcV41Tr("MATERIAL",lang),"t [mm]",gcV41Tr("JOINT",lang),gcV41Tr("POSITION",lang),"I [A]","U [V]","travel [mm/min]","η_thermal","weld L [m]","filler [kg]","arc time [min]","gas [L/min]","usable gas [L]"};
      case 20:return new String[]{"struct rise [mm]","lower finish [mm]","upper finish [mm]","max run [mm]","R_min [mm]","R_max [mm]","G_min [mm]","G_max [mm]","target 2R+G [mm]"};
      case 21:return new String[]{gcV41Tr("COST",lang),gcV41Tr("LABOR_H",lang),"hourly rate","travel","other direct","fixed overhead","overhead [%]","overhead / h","net revenue",gcV41Tr("TARGET_MARGIN",lang),"VAT [%]",gcV41Tr("PLANNED_COST",lang),gcV41Tr("ACTUAL_COST",lang),"planned h","actual h"};
      default:return new String[0];
    }
  }

  @SimpleFunction(description="Configures native Engineering inputs with the current 12-language GateCraft labels.")
  public void CenterEngineeringConfigureV41() {
    CenterEngineeringConfigure();
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    int t=gcEngToolIndex(m), lang=gcCLang();
    String[] labels=gcV41EngineeringLabels(t,lang);
    for(int i=1;i<=15;i++){
      String k=String.format(java.util.Locale.US,"%02d",i);
      if(i<=labels.length) gcCTextSet(m,"LBL_ENG_IN"+k,labels[i-1]);
    }
  }

  @SimpleFunction(description="Opens a GateCraft Center page and applies v4.1 Engineering localization after the native page transition.")
  public void CenterOpenPageV41(String pageName) {
    CenterOpenPage(pageName);
    final String p=pageName==null?"":pageName.trim().toUpperCase(java.util.Locale.ROOT);
    if("ENGINEERING".equals(p)) {
      new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new java.lang.Runnable(){public void run(){try{CenterEngineeringConfigureV41();}catch(Throwable ignored){}}},140L);
    }
  }

  private boolean gcV41EngineeringInputsValid(int t, double[] v) {
    if(t==2) return v[0]>0 && v[1]>0 && v[3]>0 && v[4]>0;
    if(t==3) return v[0]>0 && v[2]>0 && v[3]>0;
    if(t==6) return v[0]>0 && v[1]>0 && v[2]>0 && v[3]>0 && v[4]>0 && v[6]>0 && v[7]>0;
    if(t==9) {
      boolean sliding=v[0]<1.5;
      if(v[1]<=0 || v[2]<=0 || v[3]<=0 || v[7]<=0 || v[8]<=0 || v[10]<=0 || v[12]<=0) return false;
      if(!sliding && v[9]<=0) return false;
      return true;
    }
    if(t==11) return v[0]>0 && v[1]>0 && v[2]>0 && v[3]>0 && v[4]>=0 && v[5]>=0 && v[6]>=0;
    if(t==13) return v[0]>0 && v[1]>=0 && v[2]>=0 && v[3]>0 && v[4]>0 && v[5]>=0 && v[6]>0 && v[7]>=0 && v[8]>=0 && v[9]>=0 && v[10]>=0;
    return true;
  }

  @SimpleFunction(description="Runs Engineering calculation with v4.1 input validation and hinge-load clarification.")
  public void CenterEngineeringCalculateV41() {
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    int t=gcEngToolIndex(m); double[] v=gcEngV(m);
    if(!gcV41EngineeringInputsValid(t,v)) {
      gcEngLastMetrics=new java.util.HashMap<String,Double>();
      gcCTextSet(m,"LBL_ENG_RESULT","—"); gcCTextSet(m,"LBL_ENG_FORMULA",""); gcCTextSet(m,"LBL_ENG_WARNINGS",gcV41Tr("INVALID",gcCLang())); return;
    }
    CenterEngineeringCalculate();
    if(t==6) {
      double weight=v[2]*GC_ENG_G;
      double per=v[3]>0?weight/v[3]:0;
      double moment=weight*(v[0]/1000d)/2d;
      double couple=v[4]>0?moment/(v[4]/1000d):0;
      String old=gcCTextGet(m,"LBL_ENG_RESULT");
      String extra=gcV41Tr("VERT_HINGE",gcCLang())+" = "+gcEF(per,1)+" N\n"+gcV41Tr("MOMENT_REACTION",gcCLang())+" = "+gcEF(couple,1)+" N";
      gcCTextSet(m,"LBL_ENG_RESULT",old.length()>0?old+"\n"+extra:extra);
      gcEngPut(gcEngLastMetrics,"verticalPerHingeN",per);
      gcEngPut(gcEngLastMetrics,"momentCoupleReactionN",couple);
    }
  }

  @SimpleFunction(description="Saves v4.1 Engineering A/B result together with its tool identity.")
  public void CenterEngineeringSaveSideV41(String side) {
    CenterEngineeringCalculateV41();
    int t=gcEngToolIndex(gcBuildNamedComponentMap());
    if("B".equalsIgnoreCase(side)) gcV41EngBTool=t; else gcV41EngATool=t;
    CenterEngineeringSaveSide(side);
  }

  @SimpleFunction(description="Compares A/B only when both snapshots originate from the same Engineering tool.")
  public void CenterEngineeringCompareV41() {
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    if(gcV41EngATool<=0 || gcV41EngBTool<=0 || gcV41EngATool!=gcV41EngBTool) {
      gcCTextSet(m,"LBL_ENG_RESULT",gcV41Tr("SAME_TOOL",gcCLang())); return;
    }
    CenterEngineeringCompare();
  }

  @SimpleFunction(description="Project Center save wrapper with localized default project name.")
  public String ProjectHubSaveFromScreenV41() {
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    String name=gcProjectGetText(m,"TB_PROJECT_NAME").trim();
    if(name.length()==0) {
      String[] base={"Projekt","Project","Projekt","Proyecto","Projet","项目","Progetto","Projeto","Projekt","Project","Proiect","Проект"};
      int l=(int)Math.round(PlatformLanguagePreference()); if(l<1||l>12)l=2;
      name=base[l-1]+" "+new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm",java.util.Locale.US).format(new java.util.Date());
      gcProjectSetText(m,"TB_PROJECT_NAME",name);
    }
    return ProjectHubSaveFromScreen();
  }

  @SimpleFunction(description="Project delete wrapper that clears a deleted active project id.")
  public boolean ProjectHubDeleteFromScreenV41() {
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    String id=gcProjectGetText(m,"LBL_PROJECT_CURRENT_ID").trim();
    boolean ok=ProjectHubDeleteFromScreen();
    if(ok && id.equals(gcPlatformString(gcPlatformTinyGet("GC_ACTIVE_PROJECT_ID",""),""))) gcPlatformTinyPut("GC_ACTIVE_PROJECT_ID","");
    return ok;
  }

  private String gcV41PhaseText(String code,int lang) {
    String c=code==null?"":code.toUpperCase(java.util.Locale.ROOT);
    String[][] rows={
      {"SURVEY","Felmérés","Survey","Aufmaß","Relevamiento","Relevé","测量","Sopralluogo","Levantamento","Pomiar","Opname","Măsurare","Замер"},
      {"DESIGN","Tervezés","Design","Planung","Diseño","Conception","设计","Progettazione","Projeto","Projektowanie","Ontwerp","Proiectare","Проектирование"},
      {"TRAVEL","Kiszállás","Travel","Anfahrt","Desplazamiento","Déplacement","出行","Trasferta","Deslocação","Dojazd","Voorrijkosten","Deplasare","Выезд"},
      {"REPAIR","Javítás","Repair","Reparatur","Reparación","Réparation","维修","Riparazione","Reparação","Naprawa","Reparatie","Reparație","Ремонт"},
      {"MATERIAL","Anyag","Material","Material","Material","Matériau","材料","Materiale","Material","Materiał","Materiaal","Material","Материал"},
      {"PRODUCTION","Gyártás","Production","Fertigung","Producción","Fabrication","生产","Produzione","Produção","Produkcja","Productie","Producție","Производство"},
      {"FINISH","Felületkezelés","Finishing","Oberfläche","Acabado","Finition","表面处理","Finitura","Acabamento","Wykończenie","Afwerking","Finisare","Отделка"},
      {"DELIVERY","Szállítás","Delivery","Lieferung","Entrega","Livraison","运输","Consegna","Entrega","Dostawa","Levering","Livrare","Доставка"},
      {"INSTALL","Telepítés","Installation","Montage","Instalación","Installation","安装","Installazione","Instalação","Montaż","Installatie","Instalare","Монтаж"}
    };
    int l=(lang<1||lang>12)?2:lang; for(String[] r:rows)if(r[0].equals(c))return r[l]; return c;
  }

  @SimpleFunction(description="Applies a project template using stable phase codes and localized display text.")
  public double BusinessTemplateApplyFromScreenV41() {
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();
    String pid=gcBusActiveProject(); if(pid.length()==0)return 0;
    int idx=gcPlatformInt(gcPlatformGetProperty(m.get("SP_BUS_TEMPLATE"),"SelectionIndex",1),1);
    String[] phases;
    if(idx==3) phases=new String[]{"SURVEY","TRAVEL","REPAIR","MATERIAL"};
    else if(idx==2) phases=new String[]{"SURVEY","MATERIAL","PRODUCTION","FINISH","DELIVERY","INSTALL"};
    else phases=new String[]{"SURVEY","DESIGN","MATERIAL","PRODUCTION","FINISH","DELIVERY","INSTALL"};
    int lang=gcCLang();
    for(String ph:phases) BusinessCostSave("",pid,"PLAN","TEMPLATE_"+ph,gcV41PhaseText(ph,lang),1,0,"");
    BusinessRefreshScreen();
    return phases.length;
  }

  @SimpleFunction(description="GateCraft Center v4.1 action router for audit fixes while preserving the existing v3.8 action engine.")
  public void CenterActionV41(String action) {
    String a=action==null?"":action.trim().toUpperCase(java.util.Locale.ROOT);
    if("PROJECT_SAVE".equals(a)){ProjectHubSaveFromScreenV41();return;}
    if("PROJECT_DELETE".equals(a)){ProjectHubDeleteFromScreenV41();return;}
    if("BUS_TEMPLATE".equals(a)){BusinessTemplateApplyFromScreenV41();return;}
    if("ENG_CONFIGURE".equals(a)){CenterEngineeringConfigureV41();return;}
    if("ENG_CALC".equals(a)){CenterEngineeringCalculateV41();return;}
    if("ENG_SAVE_A".equals(a)){CenterEngineeringSaveSideV41("A");return;}
    if("ENG_SAVE_B".equals(a)){CenterEngineeringSaveSideV41("B");return;}
    if("ENG_COMPARE".equals(a)){CenterEngineeringCompareV41();return;}
    CenterAction(action);
  }
