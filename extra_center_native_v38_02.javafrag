  private String gcCPageTitle(String p){int l=gcCLang();if("PROFILE".equals(p))return gcPlatformText("PROFILE_TITLE",l);if("BACKUP".equals(p))return BackupUiText("TITLE",l);if("PROJECT".equals(p))return gcProjectUiText("TITLE",l);if("BUSINESS".equals(p))return gcBusText("TITLE",l);if("ENGINEERING".equals(p))return gcCText("ENGINEERING");return gcCText("CENTER");}
  private void gcCShowCover(java.util.HashMap<String,Object> m,String p){gcCTextSet(m,"LBL_GC_TAKARO_TITLE",gcCPageTitle(p));gcCTextSet(m,"LBL_GC_TAKARO_LOADING",gcCText("LOADING"));gcCVisible(m,"VA_GC_TAKARO",true);gcCVisible(m,"VA_GC_ROOT",false);}
  private void gcCLoadEngineeringProfile(java.util.HashMap<String,Object> m){String[] ns={"TXT_ENG_PROFILE_WIND","TXT_ENG_PROFILE_SNOW","TXT_ENG_PROFILE_RHO","TXT_ENG_PROFILE_SIGMA","TXT_ENG_PROFILE_KT","TXT_ENG_PROFILE_KG","TXT_ENG_PROFILE_KO","TXT_ENG_PROFILE_NOTE"};String[] ks={"GC_ENG_WIND","GC_ENG_SNOW","GC_ENG_RHO","GC_ENG_SIGMA","GC_ENG_KT","GC_ENG_KG","GC_ENG_KO","GC_ENG_NOTE"};Object[] ds={"","","1.225","","1","1","1",""};for(int i=0;i<ns.length;i++)gcCTextSet(m,ns[i],gcPlatformString(gcPlatformTinyGet(ks[i],ds[i]),String.valueOf(ds[i])));}
  private void gcCSaveEngineeringProfile(java.util.HashMap<String,Object> m){String[] ns={"TXT_ENG_PROFILE_WIND","TXT_ENG_PROFILE_SNOW","TXT_ENG_PROFILE_RHO","TXT_ENG_PROFILE_SIGMA","TXT_ENG_PROFILE_KT","TXT_ENG_PROFILE_KG","TXT_ENG_PROFILE_KO","TXT_ENG_PROFILE_NOTE"};String[] ks={"GC_ENG_WIND","GC_ENG_SNOW","GC_ENG_RHO","GC_ENG_SIGMA","GC_ENG_KT","GC_ENG_KG","GC_ENG_KO","GC_ENG_NOTE"};for(int i=0;i<ns.length;i++)gcPlatformTinyPut(ks[i],gcCTextGet(m,ns[i]));gcCAlert(m,gcCText("PROFILE_SAVED"));}
  private double gcCProf(String key,double d){return SafeNumber(gcPlatformTinyGet(key,d),d);}

  @SimpleFunction(description="Initializes the native GateCraft Center screen without WebViewer content.") public void CenterInitialize(){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();gcCenterPage="HOME";gcCShowCover(m,"HOME");gcCHidePages(m);gcCApplyTexts(m);gcCApplyTheme(m);gcCLoadEngineeringProfile(m);gcCenterHandler=new android.os.Handler(android.os.Looper.getMainLooper());}
  @SimpleFunction(description="Finishes GateCraft Center startup after its loading cover.") public void CenterFinishStartup(){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();gcCApplyTexts(m);gcCApplyTheme(m);gcCHidePages(m);gcCVisible(m,"VA_GC_HOME",true);gcCTextSet(m,"LBL_GC_PageTitle",gcCText("CENTER"));gcCVisible(m,"VA_GC_ROOT",true);gcCVisible(m,"VA_GC_TAKARO",false);CenterEngineeringConfigure();}
  private void gcCOpenNow(final String page){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();gcCenterPage=page;gcCHidePages(m);if("PROFILE".equals(page)){ProfileLoadToScreen();gcCVisible(m,"VA_PROFILE",true);}else if("BACKUP".equals(page)){BackupApplyUi();gcCVisible(m,"VA_BACKUP",true);}else if("PROJECT".equals(page)){ProjectHubApplyUi();ProjectHubRefreshPage();gcCVisible(m,"VA_PROJECT_HUB",true);}else if("BUSINESS".equals(page)){BusinessEnsureSchema();BusinessApplyUi();BusinessRefreshScreen();gcCVisible(m,"VA_BUSINESS",true);}else if("ENGINEERING".equals(page)){gcCLoadEngineeringProfile(m);CenterEngineeringConfigure();gcCVisible(m,"VA_GC_ENGINEERING",true);}else{gcCenterPage="HOME";gcCVisible(m,"VA_GC_HOME",true);}gcCApplyTexts(m);gcCApplyTheme(m);gcCTextSet(m,"LBL_GC_PageTitle",gcCPageTitle(gcCenterPage));gcCVisible(m,"VA_GC_ROOT",true);gcCVisible(m,"VA_GC_TAKARO",false);}
  @SimpleFunction(description="Opens one hidden GateCraft Center subpage.") public void CenterOpenPage(final String pageName){final String p=pageName==null?"HOME":pageName.trim().toUpperCase(java.util.Locale.ROOT);final java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();gcCShowCover(m,p);if(gcCenterHandler==null)gcCenterHandler=new android.os.Handler(android.os.Looper.getMainLooper());gcCenterHandler.postDelayed(new java.lang.Runnable(){public void run(){gcCOpenNow(p);}},90L);}
  @SimpleFunction(description="Native GateCraft Center back behavior: subpage to Center home, Center home closes screen.") public void CenterBack(){if(!"HOME".equals(gcCenterPage)){CenterOpenPage("HOME");return;}try{((android.app.Activity)form).finish();}catch(Throwable ignored){}}

  private String[] gcEngLabelsFor(int ti){try{org.json.JSONArray a=gcCTool(ti).getJSONArray("labels");String[] x=new String[a.length()];for(int i=0;i<x.length;i++)x[i]=a.optString(i,"");return x;}catch(Throwable ex){return new String[0];}}
  private String[] gcEngDefaultsFor(int ti){try{org.json.JSONArray a=gcCTool(ti).getJSONArray("defaults");String[] x=new String[a.length()];for(int i=0;i<x.length;i++)x[i]=a.optString(i,"");return x;}catch(Throwable ex){return new String[0];}}
  private int gcEngToolIndex(java.util.HashMap<String,Object> m){Object s=m.get("SP_ENG_TOOL");int i=gcPlatformInt(gcPlatformGetProperty(s,"SelectionIndex",1),1);return Math.max(1,Math.min(21,i));}
  @SimpleFunction(description="Configures the reusable native Engineering input rows for the selected tool.") public void CenterEngineeringConfigure(){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();int ti=gcEngToolIndex(m);String[] labs=gcEngLabelsFor(ti),defs=gcEngDefaultsFor(ti);gcCTextSet(m,"LBL_ENG_TOOL_DESC",gcCText("PRECHECK"));for(int i=1;i<=15;i++){String k=String.format(java.util.Locale.US,"%02d",i);boolean on=i<=labs.length;gcCVisible(m,"HA_ENG_IN"+k,on);if(on){gcCTextSet(m,"LBL_ENG_IN"+k,labs[i-1]);gcCTextSet(m,"TXT_ENG_IN"+k,defs[i-1]);}}gcCTextSet(m,"LBL_ENG_RESULT","");gcCTextSet(m,"LBL_ENG_FORMULA","");gcCTextSet(m,"LBL_ENG_WARNINGS","");}
  private double[] gcEngV(java.util.HashMap<String,Object> m){double[] v=new double[15];for(int i=1;i<=15;i++){String k=String.format(java.util.Locale.US,"%02d",i);v[i-1]=gcCNum(m,"TXT_ENG_IN"+k);}return v;}
  private String gcEngS(java.util.HashMap<String,Object> m,int i){String k=String.format(java.util.Locale.US,"%02d",i);return gcCTextGet(m,"TXT_ENG_IN"+k);}
  private String gcEF(double x,int d){return FormatNumber(x,d,false,false);}
  private void gcEngPut(java.util.HashMap<String,Double> mm,String k,double v){if(!Double.isNaN(v)&&!Double.isInfinite(v))mm.put(k,Double.valueOf(v));}
  private void gcEngOut(java.util.HashMap<String,Object> m,String r,String f,String w,java.util.HashMap<String,Double> metrics){gcCTextSet(m,"LBL_ENG_RESULT",r);gcCTextSet(m,"LBL_ENG_FORMULA",f);gcCTextSet(m,"LBL_ENG_WARNINGS",w==null||w.length()==0?gcCText("NO_WARNING"):w);gcEngLastMetrics=metrics;}
  private double gcWind(double v){double rho=gcCProf("GC_ENG_RHO",1.225d);if(rho<=0)rho=1.225d;return 0.5d*rho*v*v;}
  private double gcWindOrProfile(double v){return v>0?v:gcCProf("GC_ENG_WIND",0);}
  private String gcW(String key){return "⚠ "+gcCText(key);}


  @SimpleFunction(description="Calculates the selected native Engineering tool and writes result/formula/warning labels.")
  public void CenterEngineeringCalculate(){
    java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();int t=gcEngToolIndex(m);double[] v=gcEngV(m);java.util.HashMap<String,Double> mm=new java.util.HashMap<String,Double>();String r="",f="",w="";
    try{
      if(t==1){double q=v[1]>0?Math.floor(v[0]/v[1]):0,rem=v[0]-q*v[1];r="Nmax = "+gcEF(q,0)+" db\nRemain = "+gcEF(rem,2);f="Nmax = floor(Budget / Unit price)";if(v[1]<=0)w=gcW("INVALID");gcEngPut(mm,"count",q);gcEngPut(mm,"cost",v[0]);}
      else if(t==2){double wind=gcWindOrProfile(v[2]),q=gcWind(wind),M=v[0]*1000,h=v[1],den=q*v[3]*v[4]*h*h,s=den>0?2*M/den:0;r="s_max = "+gcEF(s,3)+" m\nq = "+gcEF(q,1)+" Pa";f="s = 2·M / (q·Cd·solidity·h²)\nq = 0.5·ρ·v²";if(wind<=0)w=gcW("NO_WIND");gcEngPut(mm,"lengthM",s);gcEngPut(mm,"momentNm",M);}
      else if(t==3){double wind=gcWindOrProfile(v[1]),q=gcWind(wind),den=q*v[2]*v[3],A=den>0?v[0]/den:0;r="A_max = "+gcEF(A,3)+" m²\nq = "+gcEF(q,1)+" Pa";f="A = F_limit / (q·Cd·solidity)";if(wind<=0)w=gcW("NO_WIND");gcEngPut(mm,"areaM2",A);gcEngPut(mm,"forceN",v[0]);}
      else if(t==4){double th=Math.atan(v[2]/100d),roll=v[0]*GC_ENG_G*v[1],sl=v[0]*GC_ENG_G*Math.sin(th),req=(roll+sl)*v[3];r="F_roll = "+gcEF(roll,1)+" N\nF_slope = "+gcEF(sl,1)+" N\nF_start = "+gcEF(req,1)+" N";f="F = (m·g·μ + m·g·sin(atan(slope/100)))·factor";gcEngPut(mm,"forceN",req);gcEngPut(mm,"massKg",v[0]);}
