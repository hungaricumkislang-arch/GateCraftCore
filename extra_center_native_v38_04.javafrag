      else if(t==17){if(v[0]<=0||v[1]<=0||v[2]<=0||v[3]<=0)throw new Exception("input");double theta=v[4]*Math.PI/180,c=Math.cos(theta);if(Math.abs(c)<0.02)throw new Exception("slope");double wind=gcWindOrProfile(v[6]),snow=v[8]>0?v[8]:gcCProf("GC_ENG_SNOW",0),sigma=v[9]>0?v[9]:gcCProf("GC_ENG_SIGMA",0),qk=gcWind(wind)/1000*Math.max(0,v[7]),wall=v[2]*v[3],Fw=qk*wall,Mw=Fw*v[2]/2,ws=snow*v[3],frameSnow=ws*v[1],Mroof=ws*v[1]*v[1]/8,half=v[1]/(2*Math.abs(c)),roofA=2*half*v[0],purlin=snow*Math.max(0,v[5]),Wp=sigma>0?Mw*1e6/sigma:0,Wr=sigma>0?Mroof*1e6/sigma:0;r="q_wind = "+gcEF(qk,3)+" kN/m²\nF/frame = "+gcEF(Fw,2)+" kN\nM_post = "+gcEF(Mw,2)+" kNm\nw_snow = "+gcEF(ws,3)+" kN/m\nSnow/frame = "+gcEF(frameSnow,2)+" kN\nM_roof = "+gcEF(Mroof,2)+" kNm\nRoof A = "+gcEF(roofA,2)+" m²\npurlin load = "+gcEF(purlin,3)+" kN/m\nWpost = "+gcEF(Wp,0)+" mm³\nWroof = "+gcEF(Wr,0)+" mm³";f="q=0.5·ρ·v²·Cd; F=q·H·frame; w_snow=snow·frame; M=w·L²/8";if(wind<=0)w=gcW("NO_WIND");if(snow<=0)w+=(w.length()>0?"\n":"")+gcW("NO_SNOW");gcEngPut(mm,"forceN",Fw*1000);gcEngPut(mm,"momentNm",Math.max(Mw,Mroof)*1000);gcEngPut(mm,"areaM2",roofA);}
      else if(t==18){double kt=v[3]>0?v[3]:gcCProf("GC_ENG_KT",1),kg=v[4]>0?v[4]:gcCProf("GC_ENG_KG",1),ko=v[5]>0?v[5]:gcCProf("GC_ENG_KO",1),iz=Math.max(0,v[0])*kt*kg*ko,start=Math.max(0,v[1])*Math.max(0,v[6]),pf=Math.max(0,Math.min(1,v[12])),sin=Math.sqrt(Math.max(0,1-pf*pf)),term=Math.max(0,v[10])*pf+Math.max(0,v[11])*sin,dv=(v[7]>=2?Math.sqrt(3):2)*Math.max(0,v[1])*Math.max(0,v[9])*term/1000,dvp=v[8]>0?dv/v[8]*100:0;boolean ok=v[1]>=0&&v[2]>=0&&v[1]<=v[2]&&v[2]<=iz;r="k_total = "+gcEF(kt*kg*ko,3)+"\nIz_corr = "+gcEF(iz,2)+" A\nIb≤In≤Iz = "+(ok?"OK":"CHECK")+"\nI_start = "+gcEF(start,1)+" A\nΔU = "+gcEF(dv,2)+" V / "+gcEF(dvp,2)+" %";f="Iz_corr=Iz·kT·kG·kO; Istart=Ib·mult; ΔU=2 or √3·I·L·(Rcosφ+Xsinφ)";if(!ok)w=gcW("LIMIT");gcEngPut(mm,"currentA",iz);}
      else if(t==19){double speed=v[8],arc=speed>0?v[7]*v[6]*60/(1000*speed):0,heat=arc*v[9],active=speed>0?v[10]*1000/speed:0,dep=v[12]>0?v[11]/(v[12]/60):0,gas=active*v[13],bottle=v[13]>0?v[14]/v[13]:0,bottles=v[14]>0?gas/v[14]:0;r="Process: "+gcEngS(m,1)+" / ISO: "+gcEngS(m,2)+"\nMaterial: "+gcEngS(m,3)+" / t="+gcEF(v[3],1)+" mm\nJoint: "+gcEngS(m,5)+" / "+gcEngS(m,6)+"\nE_arc = "+gcEF(arc,3)+" kJ/mm\nHeat = "+gcEF(heat,3)+" kJ/mm\nActive time = "+gcEF(active,1)+" min\nDeposition = "+gcEF(dep,3)+" kg/h\nGas = "+gcEF(gas,1)+" L\nBottle time = "+gcEF(bottle,1)+" min\nBottle ratio = "+gcEF(bottles,2);f="E=U·I·60/(1000·travel); Q=E·η; time=weld length/travel; gas=time·L/min";if(speed<=0||v[9]<0||v[9]>1)w=gcW("INVALID");gcEngPut(mm,"timeH",active/60);gcEngPut(mm,"massKg",v[11]);gcEngPut(mm,"heatKJmm",heat);}
      else if(t==20){double rise=v[0]+v[2]-v[1];if(rise<=0||v[3]<=0||v[4]<=0||v[5]<=0||v[4]>v[5]||v[6]<=0||v[7]<=0||v[6]>v[7])throw new Exception("input");int minN=Math.max(2,(int)Math.ceil(rise/v[5])),maxN=Math.max(minN,(int)Math.floor(rise/v[4]));double bestScore=Double.MAX_VALUE,br=0,bg=0,brun=0,bc=0,ba=0,bs=0;int bn=0;boolean bok=false;for(int n=minN;n<=maxN&&n-minN<=1000;n++){int tread=n-1;double rr=rise/n,gg=v[3]/tread,run=gg*tread,c2=2*rr+gg,ang=Math.atan2(rise,run)*180/Math.PI,str=Math.hypot(rise,run);boolean ok=gg>=v[6]&&gg<=v[7]&&rr>=v[4]&&rr<=v[5];double score=Math.abs(c2-v[8])+(ok?0:1000);if(score<bestScore){bestScore=score;bn=n;br=rr;bg=gg;brun=run;bc=c2;ba=ang;bs=str;bok=ok;}}r="finished rise = "+gcEF(rise,1)+" mm\nrises = "+bn+"\nR = "+gcEF(br,2)+" mm\nG = "+gcEF(bg,2)+" mm\n2R+G = "+gcEF(bc,1)+" mm\nrun = "+gcEF(brun,1)+" mm\nstringer = "+gcEF(bs,1)+" mm\nangle = "+gcEF(ba,2)+"°\nplumb cut = "+gcEF(90-ba,2)+"°";f="rise=struct+upper−lower; R=rise/n; G=max run/(n−1); stringer=√(rise²+run²)";if(!bok)w=gcW("LIMIT");gcEngPut(mm,"lengthM",bs/1000);gcEngPut(mm,"count",bn);}
      else if(t==21){double labor=v[1]*v[2],direct=v[0]+labor+v[3]+v[4],over=v[5]+direct*v[6]/100+v[1]*v[7],total=direct+over,profit=v[8]-total,margin=v[8]>0?profit/v[8]*100:0,target=v[9]<100?total/(1-v[9]/100):0,gross=v[8]*(1+v[10]/100),actual=v[12]!=0?v[12]:total,costVar=actual-v[11],hVar=v[14]-v[13];r="Direct = "+gcEF(direct,2)+"\nOverhead = "+gcEF(over,2)+"\nBreak-even = "+gcEF(total,2)+"\nProfit = "+gcEF(profit,2)+"\nMargin = "+gcEF(margin,1)+" %\nTarget net = "+gcEF(target,2)+"\nGross = "+gcEF(gross,2)+"\nCost Δ = "+gcEF(costVar,2)+"\nHours Δ = "+gcEF(hVar,2)+" h";f="labor=h·rate; overhead=fixed+direct·%+h·overhead/h; target=cost/(1−margin)";if(v[9]>=100)w=gcW("INVALID");gcEngPut(mm,"cost",total);gcEngPut(mm,"timeH",v[14]!=0?v[14]:v[1]);gcEngPut(mm,"profit",profit);gcEngPut(mm,"marginPct",margin);}
      gcEngOut(m,r,f,w,mm);
    }catch(Throwable ex){gcEngOut(m,"—","",gcCText("INVALID"),new java.util.HashMap<String,Double>());}
  }

  @SimpleFunction(description="Saves the last native Engineering metrics to A or B for comparison.") public void CenterEngineeringSaveSide(String side){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();if(gcEngLastMetrics==null||gcEngLastMetrics.size()==0){CenterEngineeringCalculate();}java.util.HashMap<String,Double> cp=new java.util.HashMap<String,Double>(gcEngLastMetrics);if("B".equalsIgnoreCase(side)){gcEngB=cp;gcCAlert(m,gcCText("B_SAVED"));}else{gcEngA=cp;gcCAlert(m,gcCText("A_SAVED"));}}
  @SimpleFunction(description="Compares common numeric metrics of saved A/B native Engineering results.") public void CenterEngineeringCompare(){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();if(gcEngA==null||gcEngB==null){gcCTextSet(m,"LBL_ENG_RESULT",gcCText("NEED_AB"));return;}StringBuilder sb=new StringBuilder();for(String k:gcEngA.keySet()){if(!gcEngB.containsKey(k))continue;double av=gcEngA.get(k),bv=gcEngB.get(k),d=bv-av,p=av!=0?d/av*100:0;if(sb.length()>0)sb.append("\n");sb.append(k).append(": A=").append(gcEF(av,3)).append(" | B=").append(gcEF(bv,3)).append(" | Δ=").append(gcEF(d,3)).append(" | ").append(gcEF(p,1)).append("%");}gcCTextSet(m,"LBL_ENG_RESULT",sb.length()==0?gcCText("NEED_AB"):sb.toString());gcCTextSet(m,"LBL_ENG_FORMULA","Δ = B − A; Δ% = Δ / A · 100");}

  private int gcCSelIndex(java.util.HashMap<String,Object> m,String n){return gcPlatformInt(gcPlatformGetProperty(m.get(n),"SelectionIndex",0),0);}
  @SimpleFunction(description="Runs one native GateCraft Center page action using existing profile/backup/project/business engines.") public void CenterAction(String action){java.util.HashMap<String,Object> m=gcBuildNamedComponentMap();String a=action==null?"":action.trim().toUpperCase(java.util.Locale.ROOT);
    if("PROFILE_SAVE".equals(a)){ProfileSaveFromScreen();gcCApplyTexts(m);gcCApplyTheme(m);ProfileLoadToScreen();}
    else if("BACKUP_CREATE".equals(a)){String p=BackupCreateFile();if(p.length()>0){gcCAlert(m,BackupUiText("CREATED_OK",gcCLang()));gcCCall(m.get("Sharing_BACKUP"),"ShareFile",p);}else gcCAlert(m,BackupUiText("CREATE_FAIL",gcCLang())+"\n"+BackupLastError());}
    else if("BACKUP_PICKED".equals(a)){String uri=gcPlatformString(gcPlatformGetProperty(m.get("FP_BACKUP_LOAD"),"Selection",""),"");if(BackupValidateUri(uri)){gcCenterPendingBackup=uri;gcCenterPendingBackupMode="FILE";gcCCall(m.get("Notifier_BACKUP"),"ShowChooseDialog",BackupUiText("RESTORE_Q",gcCLang()),BackupUiText("TITLE",gcCLang()),BackupUiText("YES",gcCLang()),BackupUiText("NO",gcCLang()),Boolean.TRUE);}else gcCAlert(m,BackupUiText("INVALID",gcCLang())+"\n"+BackupLastError());}
    else if("BACKUP_SNAPSHOT".equals(a)){if(BackupHasSnapshot()){gcCenterPendingBackup="";gcCenterPendingBackupMode="SNAPSHOT";gcCCall(m.get("Notifier_BACKUP"),"ShowChooseDialog",BackupUiText("SNAPSHOT",gcCLang())+"?",BackupUiText("TITLE",gcCLang()),BackupUiText("YES",gcCLang()),BackupUiText("NO",gcCLang()),Boolean.TRUE);}else gcCAlert(m,BackupUiText("SNAPSHOT_NONE",gcCLang()));}
    else if("PROJECT_NEW".equals(a))ProjectHubNewFromScreen();else if("PROJECT_SAVE".equals(a))ProjectHubSaveFromScreen();else if("PROJECT_DELETE".equals(a))ProjectHubDeleteFromScreen();else if("PROJECT_SELECT".equals(a))ProjectHubSelectFromScreen(gcCSelIndex(m,"LV_PROJECTS"));
