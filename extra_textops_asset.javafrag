  private static final class GcTextOpsRecord {
    String[] properties;
    String[] values;
  }

  private java.util.HashMap<String, GcTextOpsRecord> gcTextOpsCache = null;
  private String gcTextOpsLoadError = "";

  private synchronized void gcEnsureTextOps() {
    if (gcTextOpsCache != null) return;
    java.util.HashMap<String, GcTextOpsRecord> loaded = new java.util.HashMap<String, GcTextOpsRecord>();
    java.io.InputStream raw = null;
    java.util.zip.GZIPInputStream gzip = null;
    try {
      raw = com.google.appinventor.components.runtime.util.MediaUtil.openMedia(form, "gc_textops.dat");
      gzip = new java.util.zip.GZIPInputStream(raw);
      java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
      byte[] buffer = new byte[4096];
      int n;
      while ((n = gzip.read(buffer)) >= 0) if (n > 0) out.write(buffer, 0, n);
      String data = new String(out.toByteArray(), "UTF-8");
      String[] fields = data.length() == 0 ? new String[0] : data.split("\\u0000", -1);
      int pos = 0;
      while (pos < fields.length) {
        if (pos + 1 >= fields.length) throw new java.io.IOException("Truncated gc_textops.dat header");
        String key = fields[pos++];
        int count = Integer.parseInt(fields[pos++]);
        GcTextOpsRecord rec = new GcTextOpsRecord();
        rec.properties = new String[count];
        rec.values = new String[count];
        for (int i = 0; i < count; i++) {
          if (pos + 1 >= fields.length) throw new java.io.IOException("Truncated gc_textops.dat record " + key);
          rec.properties[i] = fields[pos++];
          rec.values[i] = fields[pos++];
        }
        loaded.put(key, rec);
      }
      gcTextOpsLoadError = "";
    } catch (Throwable ex) {
      gcTextOpsLoadError = ex.getClass().getSimpleName() + ": " + String.valueOf(ex.getMessage());
      loaded.clear();
    } finally {
      try { if (gzip != null) gzip.close(); else if (raw != null) raw.close(); } catch (Throwable ignored) { }
    }
    gcTextOpsCache = loaded;
  }

  @SimpleFunction(description = "Applies an exact prevalidated sequence of Text/ElementsFromString operations to the supplied concrete App Inventor components. The component count must exactly match the bundled operation record.")
  public double BatchApplyTextOps(YailList components, String groupKey) {
    gcEnsureTextOps();
    if (components == null || gcTextOpsCache == null || groupKey == null) return 0.0d;
    GcTextOpsRecord rec = gcTextOpsCache.get(groupKey);
    if (rec == null || rec.properties == null || rec.values == null) return 0.0d;
    if (components.size() != rec.properties.length || rec.properties.length != rec.values.length) return 0.0d;
    int ok = 0;
    for (int i = 0; i < rec.properties.length; i++) {
      if (gcSetProperty(components.getObject(i), rec.properties[i], rec.values[i])) ok++;
    }
    return ok;
  }

  @SimpleFunction(description = "Returns the number of loaded exact GateCraft text-operation records.")
  public double TextOpsCount() {
    gcEnsureTextOps();
    return gcTextOpsCache == null ? 0.0d : gcTextOpsCache.size();
  }

  @SimpleFunction(description = "Returns the last exact text-operation asset load error, or empty string on success.")
  public String TextOpsError() {
    gcEnsureTextOps();
    return gcTextOpsLoadError == null ? "" : gcTextOpsLoadError;
  }
